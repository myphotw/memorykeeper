<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      MemoryKeeper Color System — Digital Memory Album
      Bright warm-gray canvas, white cards, calm blue primary.
      Consume via {ThemeResource MkBrush*}.
    -->
    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <!-- Window: very light warm gray -->
            <Color x:Key="MkColorBackground">#F3F1ED</Color>
            <!-- Card: white -->
            <Color x:Key="MkColorSurface">#FFFFFF</Color>
            <Color x:Key="MkColorSurfaceMuted">#F7F5F1</Color>

            <!-- Calm blue primary -->
            <Color x:Key="MkColorPrimary">#5B7C99</Color>
            <Color x:Key="MkColorPrimaryHover">#4A6782</Color>
            <Color x:Key="MkColorPrimaryPressed">#3D566C</Color>

            <!-- Minimal borders — prefer shadow -->
            <Color x:Key="MkColorBorder">#E8E4DE</Color>
            <Color x:Key="MkColorDivider">#EEEBE6</Color>

            <Color x:Key="MkColorTextPrimary">#2A2825</Color>
            <Color x:Key="MkColorTextSecondary">#6E6A64</Color>
            <Color x:Key="MkColorTextDisabled">#A8A39B</Color>
            <Color x:Key="MkColorTextOnPrimary">#FFFFFF</Color>

            <Color x:Key="MkColorIcon">#7A756E</Color>
            <Color x:Key="MkColorIconMuted">#B0AAA2</Color>

            <Color x:Key="MkColorAccentGold">#B89A6A</Color>
            <Color x:Key="MkColorAccentGoldMuted">#D4C4A4</Color>

            <!-- Semantic -->
            <Color x:Key="MkColorSuccess">#3D8B5A</Color>
            <Color x:Key="MkColorWarning">#D4893A</Color>
            <Color x:Key="MkColorError">#C14B4B</Color>
            <Color x:Key="MkColorDanger">#C14B4B</Color>
            <Color x:Key="MkColorDangerHover">#A83E3E</Color>
            <Color x:Key="MkColorDangerPressed">#8F3434</Color>

            <SolidColorBrush x:Key="MkBrushBackground" Color="{StaticResource MkColorBackground}" />
            <SolidColorBrush x:Key="MkBrushSurface" Color="{StaticResource MkColorSurface}" />
            <SolidColorBrush x:Key="MkBrushSurfaceMuted" Color="{StaticResource MkColorSurfaceMuted}" />
            <SolidColorBrush x:Key="MkBrushPrimary" Color="{StaticResource MkColorPrimary}" />
            <SolidColorBrush x:Key="MkBrushPrimaryHover" Color="{StaticResource MkColorPrimaryHover}" />
            <SolidColorBrush x:Key="MkBrushPrimaryPressed" Color="{StaticResource MkColorPrimaryPressed}" />
            <SolidColorBrush x:Key="MkBrushBorder" Color="{StaticResource MkColorBorder}" />
            <SolidColorBrush x:Key="MkBrushDivider" Color="{StaticResource MkColorDivider}" />
            <SolidColorBrush x:Key="MkBrushTextPrimary" Color="{StaticResource MkColorTextPrimary}" />
            <SolidColorBrush x:Key="MkBrushTextSecondary" Color="{StaticResource MkColorTextSecondary}" />
            <SolidColorBrush x:Key="MkBrushTextDisabled" Color="{StaticResource MkColorTextDisabled}" />
            <SolidColorBrush x:Key="MkBrushTextOnPrimary" Color="{StaticResource MkColorTextOnPrimary}" />
            <SolidColorBrush x:Key="MkBrushIcon" Color="{StaticResource MkColorIcon}" />
            <SolidColorBrush x:Key="MkBrushIconMuted" Color="{StaticResource MkColorIconMuted}" />
            <SolidColorBrush x:Key="MkBrushAccentGold" Color="{StaticResource MkColorAccentGold}" />
            <SolidColorBrush x:Key="MkBrushAccentGoldMuted" Color="{StaticResource MkColorAccentGoldMuted}" />
            <SolidColorBrush x:Key="MkBrushSuccess" Color="{StaticResource MkColorSuccess}" />
            <SolidColorBrush x:Key="MkBrushWarning" Color="{StaticResource MkColorWarning}" />
            <SolidColorBrush x:Key="MkBrushError" Color="{StaticResource MkColorError}" />
            <SolidColorBrush x:Key="MkBrushDanger" Color="{StaticResource MkColorDanger}" />
            <SolidColorBrush x:Key="MkBrushDangerHover" Color="{StaticResource MkColorDangerHover}" />
            <SolidColorBrush x:Key="MkBrushDangerPressed" Color="{StaticResource MkColorDangerPressed}" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <Color x:Key="MkColorBackground">#1A1916</Color>
            <Color x:Key="MkColorSurface">#26241F</Color>
            <Color x:Key="MkColorSurfaceMuted">#201E1A</Color>
            <Color x:Key="MkColorPrimary">#8A9BB0</Color>
            <Color x:Key="MkColorPrimaryHover">#A0AEBF</Color>
            <Color x:Key="MkColorPrimaryPressed">#B4C0CD</Color>
            <Color x:Key="MkColorBorder">#3A3732</Color>
            <Color x:Key="MkColorDivider">#322F2A</Color>
            <Color x:Key="MkColorTextPrimary">#F2EFE8</Color>
            <Color x:Key="MkColorTextSecondary">#A8A297</Color>
            <Color x:Key="MkColorTextDisabled">#6E695F</Color>
            <Color x:Key="MkColorTextOnPrimary">#1A1916</Color>
            <Color x:Key="MkColorIcon">#9A948A</Color>
            <Color x:Key="MkColorIconMuted">#6E695F</Color>
            <Color x:Key="MkColorAccentGold">#C4A878</Color>
            <Color x:Key="MkColorAccentGoldMuted">#8A7650</Color>
            <Color x:Key="MkColorSuccess">#5CA072</Color>
            <Color x:Key="MkColorWarning">#D4A574</Color>
            <Color x:Key="MkColorError">#D07A7A</Color>
            <Color x:Key="MkColorDanger">#D07A7A</Color>
            <Color x:Key="MkColorDangerHover">#E09090</Color>
            <Color x:Key="MkColorDangerPressed">#B86868</Color>

            <SolidColorBrush x:Key="MkBrushBackground" Color="{StaticResource MkColorBackground}" />
            <SolidColorBrush x:Key="MkBrushSurface" Color="{StaticResource MkColorSurface}" />
            <SolidColorBrush x:Key="MkBrushSurfaceMuted" Color="{StaticResource MkColorSurfaceMuted}" />
            <SolidColorBrush x:Key="MkBrushPrimary" Color="{StaticResource MkColorPrimary}" />
            <SolidColorBrush x:Key="MkBrushPrimaryHover" Color="{StaticResource MkColorPrimaryHover}" />
            <SolidColorBrush x:Key="MkBrushPrimaryPressed" Color="{StaticResource MkColorPrimaryPressed}" />
            <SolidColorBrush x:Key="MkBrushBorder" Color="{StaticResource MkColorBorder}" />
            <SolidColorBrush x:Key="MkBrushDivider" Color="{StaticResource MkColorDivider}" />
            <SolidColorBrush x:Key="MkBrushTextPrimary" Color="{StaticResource MkColorTextPrimary}" />
            <SolidColorBrush x:Key="MkBrushTextSecondary" Color="{StaticResource MkColorTextSecondary}" />
            <SolidColorBrush x:Key="MkBrushTextDisabled" Color="{StaticResource MkColorTextDisabled}" />
            <SolidColorBrush x:Key="MkBrushTextOnPrimary" Color="{StaticResource MkColorTextOnPrimary}" />
            <SolidColorBrush x:Key="MkBrushIcon" Color="{StaticResource MkColorIcon}" />
            <SolidColorBrush x:Key="MkBrushIconMuted" Color="{StaticResource MkColorIconMuted}" />
            <SolidColorBrush x:Key="MkBrushAccentGold" Color="{StaticResource MkColorAccentGold}" />
            <SolidColorBrush x:Key="MkBrushAccentGoldMuted" Color="{StaticResource MkColorAccentGoldMuted}" />
            <SolidColorBrush x:Key="MkBrushSuccess" Color="{StaticResource MkColorSuccess}" />
            <SolidColorBrush x:Key="MkBrushWarning" Color="{StaticResource MkColorWarning}" />
            <SolidColorBrush x:Key="MkBrushError" Color="{StaticResource MkColorError}" />
            <SolidColorBrush x:Key="MkBrushDanger" Color="{StaticResource MkColorDanger}" />
            <SolidColorBrush x:Key="MkBrushDangerHover" Color="{StaticResource MkColorDangerHover}" />
            <SolidColorBrush x:Key="MkBrushDangerPressed" Color="{StaticResource MkColorDangerPressed}" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>

