<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="MkPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MkFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource MkFontSizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource MkBrushTextPrimary}" />
        <Setter Property="Margin" Value="0,0,0,20" />
    </Style>

    <Style x:Key="MkSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MkFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource MkFontSizeSection}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource MkBrushTextPrimary}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- Place / trip names read before counts -->
    <Style x:Key="MkPlaceNameStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MkFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource MkFontSizePlaceName}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource MkBrushTextPrimary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="MkCardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MkFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource MkFontSizeCardTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource MkBrushTextPrimary}" />
        <Setter Property="Margin" Value="{StaticResource MkCardHeaderContentMargin}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="MkBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MkFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource MkFontSizeBody}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource MkBrushTextPrimary}" />
        <Setter Property="LineHeight" Value="{StaticResource MkLineHeightBody}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="MkCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MkFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource MkFontSizeCaption}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource MkBrushTextSecondary}" />
        <Setter Property="LineHeight" Value="{StaticResource MkLineHeightCaption}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Meta / counts stay quieter than place names -->
    <Style x:Key="MkMetaTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MkCaptionTextStyle}">
        <Setter Property="Opacity" Value="0.85" />
    </Style>

    <Style x:Key="MkSuggestionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MkFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource MkFontSizeCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource MkBrushTextSecondary}" />
        <Setter Property="Margin" Value="4,0,4,6" />
    </Style>
</ResourceDictionary>

