<Page
    x:Class="MemoryKeeper.App.Views.SetupWizardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel MaxWidth="720" HorizontalAlignment="Center" Spacing="16" Padding="12">
            <TextBlock Text="Memory Keeper 초기 설정" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="최초 실행에 필요한 설정을 진행합니다." Opacity="0.75" />
            <TextBlock Text="{Binding StatusMessage, Mode=OneWay}" TextWrapping="Wrap" />

            <StackPanel x:ConnectionId='2' x:Name="Step1Panel" Spacing="12">
                <TextBlock Text="1단계 — MemoryKeeper 저장소" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="현재 위치" FontWeight="SemiBold" />
                <TextBlock Text="{Binding PhotoRoot, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.85" IsTextSelectionEnabled="True" />
                <Button Content="폴더 선택" Command="{Binding BrowsePhotoRootCommand}" />
            </StackPanel>

            <StackPanel x:ConnectionId='3' x:Name="Step2Panel" Spacing="12" Visibility="Collapsed">
                <TextBlock Text="2단계 — 집 위치" FontSize="20" FontWeight="SemiBold" />
                <TextBox Header="주소" Text="{Binding HomeAddress, Mode=TwoWay}" PlaceholderText="예: 서울특별시 중구 …" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <TextBox Header="위도" Text="{Binding HomeLatitude, Mode=TwoWay}" />
                    <TextBox Grid.Column="1" Header="경도" Text="{Binding HomeLongitude, Mode=TwoWay}" />
                </Grid>
                <TextBlock Text="주소 변환이 어려우면 위도/경도를 직접 입력하세요." Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel x:ConnectionId='4' x:Name="Step3Panel" Spacing="12" Visibility="Collapsed">
                <TextBlock Text="3단계 — Google Maps (선택)" FontSize="20" FontWeight="SemiBold" />
                <PasswordBox x:ConnectionId='8' x:Name="ApiKeyBox" Header="API Key"                                               />
                <TextBlock Text="입력하지 않으면 방문지도의 지도만 비활성화됩니다." Opacity="0.7" TextWrapping="Wrap" />
                <Button Content="건너뛰기" Command="{Binding SkipMapsCommand}" />
            </StackPanel>

            <StackPanel x:ConnectionId='5' x:Name="Step4Panel" Spacing="12" Visibility="Collapsed">
                <TextBlock Text="4단계 — 완료" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="필수 설정이 준비되었습니다. Home 화면으로 이동합니다." TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="이전" Command="{Binding BackCommand}" />
                <Button x:ConnectionId='6'
                    x:Name="NextButton"
                    Content="다음"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{Binding NextCommand}" />
                <Button x:ConnectionId='7'
                    x:Name="FinishButton"
                    Content="완료"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{Binding FinishCommand}"
                    Visibility="Collapsed" />
            </StackPanel>

            <ProgressRing IsActive="{Binding IsBusy, Mode=OneWay}" Width="32" Height="32" />
        </StackPanel>
    </ScrollViewer>
</Page>

