<Page
    x:Class="MemoryKeeper.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:MemoryKeeper.App.Converters"
    xmlns:dto="using:MemoryKeeper.Application.DTOs"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid
        Background="{ThemeResource MkBrushBackground}"
        ColumnDefinitions="200,*"
        ColumnSpacing="16">
        <Border Style="{StaticResource MkCardStyle}" Margin="0" Padding="16">
            <ScrollViewer MinWidth="140">
                <StackPanel Spacing="6" Padding="0,4">
                    <TextBlock Text="설정" Style="{StaticResource MkPageTitleStyle}" Margin="0,0,0,12" />

                    <TextBlock Text="일반" Style="{StaticResource MkCaptionTextStyle}" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <Button Content="MemoryKeeper 저장소" HorizontalAlignment="Stretch"
                            Style="{StaticResource MkSecondaryButtonStyle}"
                            Command="{Binding ShowStorageCommand}" />
                    <Button Content="집(Home) 위치" HorizontalAlignment="Stretch"
                            Style="{StaticResource MkSecondaryButtonStyle}"
                            Command="{Binding ShowHomeCommand}" />
                    <Button Content="Google API" HorizontalAlignment="Stretch"
                            Style="{StaticResource MkSecondaryButtonStyle}"
                            Command="{Binding ShowGoogleApiCommand}" />

                    <TextBlock Text="사진" Style="{StaticResource MkCaptionTextStyle}" FontWeight="SemiBold" Margin="0,16,0,0" />
                    <Button Content="사진관리" HorizontalAlignment="Stretch"
                            Style="{StaticResource MkSecondaryButtonStyle}"
                            Command="{Binding ShowPhotoImportCommand}" />
                    <Button Content="태그 관리" HorizontalAlignment="Stretch"
                            Style="{StaticResource MkSecondaryButtonStyle}"
                            Command="{Binding ShowTagsCommand}" />

                    <TextBlock Text="AI" Style="{StaticResource MkCaptionTextStyle}" FontWeight="SemiBold" Margin="0,16,0,0" />
                    <Button Content="AI (준비 중)" HorizontalAlignment="Stretch"
                            Style="{StaticResource MkSecondaryButtonStyle}"
                            Command="{Binding ShowAiCommand}" />

                    <TextBlock Text="유지보수" Style="{StaticResource MkCaptionTextStyle}" FontWeight="SemiBold" Margin="0,16,0,0" />
                    <Button Content="유지보수" HorizontalAlignment="Stretch"
                            Style="{StaticResource MkSecondaryButtonStyle}"
                            Command="{Binding ShowMaintenanceCommand}" />

                    <TextBlock Text="정보" Style="{StaticResource MkCaptionTextStyle}" FontWeight="SemiBold" Margin="0,16,0,0" />
                    <Button Content="프로그램 정보" HorizontalAlignment="Stretch"
                            Style="{StaticResource MkSecondaryButtonStyle}"
                            Command="{Binding ShowInfoCommand}" />
                    <Button Content="로그 보기" HorizontalAlignment="Stretch"
                            Style="{StaticResource MkSecondaryButtonStyle}"
                            Command="{Binding ShowLogsCommand}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource MkCardStyle}" Margin="0" Padding="20">
            <ScrollViewer Padding="4,0,0,0">
                <StackPanel Spacing="16" Padding="4" MaxWidth="600" HorizontalAlignment="Left">
                <InfoBar
                    IsOpen="{Binding IsInfoBarOpen, Mode=TwoWay}"
                    Severity="{Binding InfoBarSeverity, Mode=OneWay}"
                    Message="{Binding InfoBarMessage, Mode=OneWay}"
                    IsClosable="True" />

                <StackPanel
                    Spacing="10"
                    Visibility="{Binding IsOverviewVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="설정" Style="{StaticResource MkSectionTitleStyle}" />
                    <TextBlock
                        Text="왼쪽 메뉴에서 항목을 선택하세요."
                        Opacity="0.75"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!-- 일반 -->
                <StackPanel
                    Spacing="10"
                    Visibility="{Binding IsGeneralVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel
                        Spacing="10"
                        Visibility="{Binding IsStoragePanelVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="MemoryKeeper 저장소" Style="{StaticResource MkSectionTitleStyle}" />
                        <TextBlock Text="현재 위치" FontWeight="SemiBold" Margin="{StaticResource MkLabelSpacing}" />
                        <TextBlock
                            Text="{Binding Storage.PhotoRootPath, Mode=OneWay}"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True"
                            Opacity="0.85"
                            MaxWidth="{StaticResource MkInputMaxWidth}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="폴더 변경" Style="{StaticResource MkButtonStyle}" Command="{Binding ChangeStorageFolderCommand}" />
                            <Button Content="연결 확인" Style="{StaticResource MkButtonStyle}" Command="{Binding CheckStorageConnectionCommand}" />
                        </StackPanel>
                        <TextBlock
                            Text="접근할 수 없습니다."
                            Visibility="{Binding Storage.ShowConnectionError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            Foreground="#C42B1C" />
                        <StackPanel
                            Spacing="4"
                            Visibility="{Binding Storage.ShowConnectionDetails, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding Storage.ReadableStatusText, Mode=OneWay}" />
                            <TextBlock Text="{Binding Storage.WritableStatusText, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel
                        Spacing="10"
                        Visibility="{Binding IsHomePanelVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="집(Home) 위치" Style="{StaticResource MkSectionTitleStyle}" />
                        <TextBlock
                            Text="주소를 입력하면 자동완성 목록에서 선택할 수 있습니다. 위도/경도는 자동으로 저장됩니다."
                            Opacity="0.75"
                            TextWrapping="Wrap" />
                        <TextBox x:ConnectionId='4'
                            x:Name="HomeAddressBox"
                            Style="{StaticResource MkTextBoxStyle}"
                            Header="주소 검색"
                            Text="{Binding HomeAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="예: 구일로" />
                        <Border x:ConnectionId='5'
                            x:Name="HomeSuggestionsPanel"
                            Style="{StaticResource MkSuggestionPanelStyle}"
                            MaxWidth="{StaticResource MkInputMaxWidth}"
                            HorizontalAlignment="Left"
                            Visibility="{Binding HasHomeSuggestions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="검색 결과" Style="{StaticResource MkSuggestionHeaderStyle}" />
                                <ListView x:ConnectionId='6'
                                    ItemsSource="{Binding HomeSuggestions, Mode=OneWay}"
                                    IsItemClickEnabled="True"
                                                                          
                                    MaxHeight="200"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Spacing="2" Padding="4,6">
                                                <TextBlock Text="{Binding PrimaryText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding SecondaryText}" Opacity="0.7" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                        <TextBlock
                            Text="{Binding HomeResolvedSummary, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Opacity="0.85"
                            MaxWidth="{StaticResource MkInputMaxWidth}" />
                        <Button Content="선택 위치 저장" Style="{StaticResource MkButtonStyle}" Command="{Binding SaveHomeCommand}" />
                    </StackPanel>

                    <StackPanel
                        Spacing="10"
                        Visibility="{Binding IsGooglePanelVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Google API" Style="{StaticResource MkSectionTitleStyle}" />
                        <TextBlock
                            Text="Maps JavaScript / Geocoding / Places(레거시) API가 활성화된 Google API Key(AIza…)를 저장하세요. 전체 초기화를 제외하면 API Key는 유지됩니다."
                            Opacity="0.75"
                            TextWrapping="Wrap" />
                        <PasswordBox x:ConnectionId='3'
                            x:Name="ApiKeyBox"
                            Style="{StaticResource MkPasswordBoxStyle}"
                            Header="API Key"
                                                                          />
                        <Button Content="저장" Style="{StaticResource MkButtonStyle}" Command="{Binding SaveApiKeyCommand}" />
                    </StackPanel>
                </StackPanel>

                <!-- 사진 -->
                <StackPanel
                    Spacing="12"
                    Visibility="{Binding IsPhotoVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="사진관리" Style="{StaticResource MkSectionTitleStyle}" />
                    <TextBlock
                        Text="사진관리 화면에서 폴더를 선택하고 등록을 실행합니다. 등록 시 EXIF 촬영일·GPS는 자동 분석됩니다."
                        Opacity="0.75"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="사진등록" Command="{Binding OpenImportCommand}" Style="{StaticResource MkButtonStyle}" />
                        <Button Content="미완성 추억" Command="{Binding OpenPendingCommand}" Style="{StaticResource MkButtonStyle}" />
                        <Button Content="장소 관리" Command="{Binding OpenPlaceCommand}" Style="{StaticResource MkButtonStyle}" />
                    </StackPanel>
                    <Button
                        Content="사본 무결성 검사"
                        HorizontalAlignment="Left"
                        Command="{Binding InspectLibraryCopiesCommand}" />
                    <TextBlock
                        Text="동일 Hash 사본 중복·경로 불일치·누락 파일을 검사하고 자동 복구합니다."
                        Opacity="0.75"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="Debug 빌드에서는 사진 정보 화면에서 EXIF 보기를 사용할 수 있습니다."
                        Opacity="0.75"
                        TextWrapping="Wrap"
                        Margin="0,8,0,0" />
                </StackPanel>

                <!-- AI -->
                <StackPanel
                    Spacing="10"
                    Visibility="{Binding IsAiVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="AI" Style="{StaticResource MkSectionTitleStyle}" />
                    <TextBlock
                        Text="향후 AI 검색·자동 태깅 기능이 이 영역에 추가됩니다."
                        Opacity="0.75"
                        TextWrapping="Wrap" />
                    <InfoBar
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Informational"
                        Title="준비 중"
                        Message="AI 기능은 아직 제공되지 않습니다." />
                </StackPanel>

                <!-- 유지보수 -->
                <StackPanel
                    Spacing="12"
                    Visibility="{Binding IsMaintenanceVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="유지보수" Style="{StaticResource MkSectionTitleStyle}" />
                    <TextBlock
                        Text="사진 원본 파일은 삭제하지 않습니다. 작업 전 백업을 권장합니다."
                        Opacity="0.75"
                        TextWrapping="Wrap" />

                    <StackPanel Spacing="4">
                        <Button Content="등록사진 초기화" HorizontalAlignment="Left"
                                Command="{Binding ClearImportDataCommand}" />
                        <TextBlock
                            Text="DB의 사진·장소·태그 등록 정보를 모두 지웁니다. 저장소의 사진 원본과 Google API Key는 유지됩니다."
                            Opacity="0.75"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <Button Content="장소/여행기록 재생성" HorizontalAlignment="Left"
                                Command="{Binding RegeneratePlacesCommand}" />
                        <TextBlock
                            Text="기존 장소를 모두 지운 뒤, GPS가 있는 사진마다 Google 위치 조회·반경 매칭으로 장소를 다시 만들고 연결합니다. 방문지도·여행기록은 장소/사진 기준으로 다시 집계됩니다. API Key는 유지됩니다."
                            Opacity="0.75"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <Button Content="장소 재정규화" HorizontalAlignment="Left"
                                Command="{Binding RenormalizePlacesCommand}" />
                        <TextBlock
                            Text="장소 이름은 유지한 채 Canonical 이름을 다시 맞추고, Osaka / Osaka-shi / 大阪市처럼 같은 지역을 하나로 병합합니다. 연결된 사진은 대표 장소로 재연결됩니다."
                            Opacity="0.75"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <Button Content="썸네일 캐시 삭제" HorizontalAlignment="Left"
                                Command="{Binding ClearThumbnailCacheCommand}" />
                        <TextBlock
                            Text="미리보기용 썸네일 캐시만 삭제합니다. 다음에 화면을 열 때 다시 생성됩니다. 원본·DB·API Key는 유지됩니다."
                            Opacity="0.75"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <Button Content="전체 초기화" HorizontalAlignment="Left"
                                Command="{Binding ResetDatabaseCommand}" />
                        <TextBlock
                            Text="데이터베이스·설정·썸네일 캐시를 초기화합니다. Google API Key도 삭제됩니다. 사진 원본만 남고, 앱을 다시 시작하면 초기 설정이 표시됩니다."
                            Opacity="0.75"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="4" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="백업" Command="{Binding BackupCommand}" />
                            <Button Content="복원" Command="{Binding RestoreCommand}" />
                        </StackPanel>
                        <TextBlock
                            Text="백업: DB 등을 zip으로 저장합니다. 복원: 선택한 zip으로 현재 DB를 덮어씁니다."
                            Opacity="0.75"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <!-- 정보 -->
                <StackPanel
                    Spacing="10"
                    Visibility="{Binding IsInfoVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="정보" Style="{StaticResource MkSectionTitleStyle}" />
                    <TextBlock Text="프로그램 버전" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding AppVersionText, Mode=OneWay}" Style="{StaticResource MkBodyTextStyle}" />
                    <StackPanel
                        Spacing="10"
                        Visibility="{Binding IsLogsVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="로그" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="새로고침" Style="{StaticResource MkSecondaryButtonStyle}" Command="{Binding RefreshLogsCommand}" />
                        </Grid>
                        <TextBox
                            Style="{StaticResource MkTextBoxStyle}"
                            Text="{Binding LogText, Mode=OneWay}"
                            IsReadOnly="True"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            MinHeight="360"
                            MaxWidth="720"
                            FontFamily="Consolas"
                            FontSize="12" />
                    </StackPanel>
                </StackPanel>

                <Grid
                    MinHeight="480"
                    Visibility="{Binding IsTagsVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ContentControl x:ConnectionId='2' x:Name="TagHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                </Grid>

                <ProgressRing IsActive="{Binding IsBusy, Mode=OneWay}" Width="32" Height="32" HorizontalAlignment="Left" />
            </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>

