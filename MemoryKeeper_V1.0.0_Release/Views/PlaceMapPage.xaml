<Page x:ConnectionId='1'
    x:Class="MemoryKeeper.App.Views.PlaceMapPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MemoryKeeper.App.Models"
    xmlns:converters="using:MemoryKeeper.App.Converters"
    mc:Ignorable="d"
                                  
                                      >

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid ColumnDefinitions="340,*" ColumnSpacing="16" RowDefinitions="Auto,*" RowSpacing="12">
        <TextBlock
            Grid.ColumnSpan="2"
            Text="Place Map"
            FontSize="28"
            FontWeight="SemiBold" />

        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" RowSpacing="8">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                <ComboBox x:ConnectionId='17'
                    Header="년도"
                                                                                
                                                                               
                    HorizontalAlignment="Stretch" />
                <Button x:ConnectionId='18'
                    Grid.Column="1"
                    Content="전체"
                    VerticalAlignment="Bottom"
                                                                        />
                <Button x:ConnectionId='19'
                    Grid.Column="2"
                    Content="검색"
                    Style="{StaticResource AccentButtonStyle}"
                    VerticalAlignment="Bottom"
                                                               />
                <Button x:ConnectionId='20'
                    Grid.Column="3"
                    Content="사진"
                    VerticalAlignment="Bottom"
                                                                        />
            </Grid>

            <TextBlock x:ConnectionId='7'
                Grid.Row="1"
                                                                    
                Opacity="0.8"
                TextWrapping="Wrap" />

            <ListView x:ConnectionId='8'
                Grid.Row="2"
                                                                    
                                                                            >
                <ListView.ItemTemplate>
                    <DataTemplate                                 >
                        <StackPanel x:ConnectionId='10' Spacing="2" Padding="0,8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock x:ConnectionId='15'                           FontWeight="SemiBold" />
                                <TextBlock x:ConnectionId='16'
                                    Text="★"
                                    Foreground="#E6A700"
                                                                                                                            />
                            </StackPanel>
                            <TextBlock x:ConnectionId='11'                               Opacity="0.75" FontSize="12" />
                            <TextBlock Opacity="0.85" FontSize="12">
                                <Run Text="방문 " />
                                <Run x:ConnectionId='12'                                  />
                                <Run Text=" · 사진 " />
                                <Run x:ConnectionId='13'                            />
                                <Run Text=" · 최근 " />
                                <Run x:ConnectionId='14'                               />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:ConnectionId='3' Content="Zoom -"                                             />
                <Button x:ConnectionId='4' Content="Zoom +"                                            />
                <Button x:ConnectionId='5' Content="전체 보기"                                            />
                <TextBlock x:ConnectionId='6'
                                                                    
                    VerticalAlignment="Center"
                    Opacity="0.75"
                    Margin="8,0,0,0" />
            </StackPanel>

            <Border
                Grid.Row="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <WebView2 x:ConnectionId='2' x:Name="MapWebView" />
            </Border>
        </Grid>
    </Grid>
</Page>

