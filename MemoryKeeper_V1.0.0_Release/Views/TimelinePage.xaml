<Page x:ConnectionId='1'
    x:Class="MemoryKeeper.App.Views.TimelinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MemoryKeeper.App.Models"
    xmlns:converters="using:MemoryKeeper.App.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="12">
        <TextBlock
            Text="Timeline"
            FontSize="28"
            FontWeight="SemiBold" />

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBox x:ConnectionId='36'
                x:Name="SearchBox"
                PlaceholderText="오사카 맛집, 작년 벚꽃, 즐겨찾기 음식..."
                                                                                                      
                                             
                                                />
            <Button x:ConnectionId='37'
                Grid.Column="1"
                Content="⌕"
                ToolTipService.ToolTip="검색"
                Width="48"
                Style="{StaticResource AccentButtonStyle}"
                                                           />
            <Button x:ConnectionId='38'
                Grid.Column="2"
                Content="최근"
                Width="64"
                                                               />
        </Grid>

        <Grid Grid.Row="2">
            <Border x:ConnectionId='29'
                x:Name="SuggestionsPanel"
                Style="{StaticResource MkSuggestionPanelStyle}"
                                                                                                                                   >
                <StackPanel Spacing="4">
                    <TextBlock Text="검색 결과" Style="{StaticResource MkSuggestionHeaderStyle}" />
                    <ListView x:ConnectionId='33'
                                                                                 
                        IsItemClickEnabled="True"
                                                          
                        MaxHeight="180"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate                                         >
                                <TextBlock x:ConnectionId='35'                             Margin="8,6" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <Border x:ConnectionId='30'
                x:Name="RecentPanel"
                Style="{StaticResource MkSuggestionPanelStyle}"
                                                                                                                               >
                <StackPanel Spacing="4">
                    <TextBlock Text="최근 검색" Style="{StaticResource MkSuggestionHeaderStyle}" />
                    <ListView x:ConnectionId='31'
                                                                                   
                        IsItemClickEnabled="True"
                                                      
                        MaxHeight="180"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Margin="4,4" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl x:ConnectionId='25'                                                          >
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate                                   >
                            <Border x:ConnectionId='27'
                                Padding="10,4"
                                CornerRadius="12"
                                Background="{ThemeResource AccentFillColorDefaultBrush}">
                                <TextBlock x:ConnectionId='28'
                                                                
                                    Foreground="White"
                                    FontSize="12" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Grid.Row="1" ColumnDefinitions="160,Auto,Auto,Auto,*" ColumnSpacing="8">
                <ComboBox x:ConnectionId='20'
                    Header="년도 (선택)"
                                                                                
                                                                               
                    HorizontalAlignment="Stretch" />
                <Button x:ConnectionId='21'
                    Grid.Column="1"
                    Content="전체 년도"
                    VerticalAlignment="Bottom"
                                                                        />
                <Button x:ConnectionId='22'
                    Grid.Column="2"
                    Content="지도에서 보기"
                    VerticalAlignment="Bottom"
                                                                />
                <Button x:ConnectionId='23'
                    Grid.Column="3"
                    Content="갤러리에서 보기"
                    VerticalAlignment="Bottom"
                                                                    />
                <TextBlock x:ConnectionId='24'
                    Grid.Column="4"
                                                                        
                    VerticalAlignment="Bottom"
                    Margin="8,0,0,8"
                    TextWrapping="Wrap"
                    Opacity="0.8" />
            </Grid>

            <StackPanel x:ConnectionId='18'
                Grid.Row="2"
                Spacing="8"
                                                                                                                               >
                <TextBlock Text="검색 결과가 없습니다." FontSize="16" Opacity="0.85" />
                <Button x:ConnectionId='19'
                    Content="조건 초기화"
                    HorizontalAlignment="Left"
                                                                    />
            </StackPanel>
        </Grid>

        <ListView x:ConnectionId='2'
            Grid.Row="4"
                                                                    
            SelectionMode="None"
                                                                                                                                                      >
            <ListView.ItemTemplate>
                <DataTemplate                                      >
                    <StackPanel x:ConnectionId='4' Spacing="8" Margin="0,0,0,16">
                        <TextBlock x:ConnectionId='5'
                                                     
                            FontSize="20"
                            FontWeight="SemiBold" />

                        <ItemsControl x:ConnectionId='6'                              >
                            <ItemsControl.ItemTemplate>
                                <DataTemplate                                      >
                                    <Border x:ConnectionId='8'
                                        Padding="12"
                                        Margin="0,0,0,8"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock x:ConnectionId='16'
                                                                             
                                                    FontSize="16"
                                                    FontWeight="SemiBold" />
                                                <TextBlock x:ConnectionId='17'
                                                    Text="★"
                                                    FontSize="14"
                                                    Foreground="#E6A700"
                                                                                                                                            />
                                            </StackPanel>

                                            <Button x:ConnectionId='9'
                                                Grid.Column="1"
                                                Content="선택"
                                                                                 
                                                               />
                                            <Button x:ConnectionId='10'
                                                Grid.Column="2"
                                                Content="사진"
                                                                                    
                                                               />

                                            <TextBlock x:ConnectionId='11'
                                                Grid.Row="1"
                                                Grid.ColumnSpan="3"
                                                                             
                                                Opacity="0.75" />

                                            <TextBlock
                                                Grid.Row="2"
                                                Grid.ColumnSpan="3"
                                                Opacity="0.85">
                                                <Run Text="방문 " />
                                                <Run x:ConnectionId='12'                                  />
                                                <Run Text=" · 사진 " />
                                                <Run x:ConnectionId='13'                            />
                                                <Run Text=" · 첫 방문 " />
                                                <Run x:ConnectionId='14'                                />
                                                <Run Text=" · 최근 방문 " />
                                                <Run x:ConnectionId='15'                               />
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>

