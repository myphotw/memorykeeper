<Page x:ConnectionId='1'
    x:Class="MemoryKeeper.App.Views.PhotoDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MemoryKeeper.App.Models"
    xmlns:converters="using:MemoryKeeper.App.Converters"
    mc:Ignorable="d"
                                     
                                         
                                       >

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="8" MinWidth="640" MinHeight="400">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
            <Button Content="뒤로" Command="{Binding CloseCommand}" Padding="10,4" MinWidth="56" />
            <TextBlock
                Grid.Column="1"
                Text="사진 상세"
                FontSize="22"
                FontWeight="SemiBold"
                VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                Grid.Column="2"
                Text="{Binding PlaylistPositionText, Mode=OneWay}"
                VerticalAlignment="Center"
                Opacity="0.75" />
            <Button x:ConnectionId='13' Grid.Column="3" Content="맞춤"                         MinWidth="48" />
            <Button x:ConnectionId='14' Grid.Column="4" Content="확대"                        MinWidth="48" />
            <Button x:ConnectionId='15' Grid.Column="5" Content="축소"                         MinWidth="48" />
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="1" ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition x:ConnectionId='2' x:Name="InfoColumn" Width="320" MinWidth="200" MaxWidth="720" />
            </Grid.ColumnDefinitions>

            <Border x:ConnectionId='3'
                x:Name="PhotoPane"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                CornerRadius="8"
                                                     >
                <ScrollViewer x:ConnectionId='11'
                    x:Name="PhotoScrollViewer"
                    ZoomMode="Enabled"
                    MinZoomFactor="0.25"
                    MaxZoomFactor="8"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                                                                   >
                    <Image x:ConnectionId='12'
                        x:Name="PhotoImageControl"
                        Source="{Binding PhotoImage, Mode=OneWay}"
                        Stretch="Uniform"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </ScrollViewer>
            </Border>

            <Border x:ConnectionId='4'
                Grid.Column="1"
                Background="{ThemeResource CardStrokeColorDefaultBrush}"
                Opacity="0.5"
                                                          
                                                      
                                                            
                                                               
                ManipulationMode="TranslateX" />

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="12,0,4,0">
                <StackPanel Spacing="14">
                    <TextBlock Text="{Binding FileName, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StatusMessage, Mode=OneWay}" Opacity="0.75" TextWrapping="Wrap" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="촬영 정보" FontWeight="SemiBold" />
                        <TextBlock Opacity="0.85"><Run Text="촬영일시: "/><Run Text="{Binding CapturedAtText, Mode=OneWay}"/></TextBlock>
                        <TextBlock Opacity="0.85"><Run Text="촬영기기: "/><Run Text="{Binding CameraText, Mode=OneWay}"/></TextBlock>
                        <TextBlock Opacity="0.85"><Run Text="노출시간: "/><Run Text="{Binding ExposureText, Mode=OneWay}"/></TextBlock>
                        <TextBlock Opacity="0.85"><Run Text="조리개: "/><Run Text="{Binding ApertureText, Mode=OneWay}"/></TextBlock>
                        <TextBlock Opacity="0.85"><Run Text="ISO: "/><Run Text="{Binding IsoText, Mode=OneWay}"/></TextBlock>
                        <TextBlock Opacity="0.85"><Run Text="렌즈: "/><Run Text="{Binding LensText, Mode=OneWay}"/></TextBlock>
                        <TextBlock Opacity="0.85"><Run Text="초점거리: "/><Run Text="{Binding FocalLengthText, Mode=OneWay}"/></TextBlock>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="위치 정보" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding GpsStatusText, Mode=OneWay}" FontWeight="SemiBold" />
                        <TextBlock Opacity="0.85"><Run Text="현재 장소: "/><Run Text="{Binding PlaceName, Mode=OneWay}"/> (<Run Text="{Binding PlaceStatusText, Mode=OneWay}"/>)</TextBlock>
                        <TextBlock Opacity="0.85"><Run Text="Canonical: "/><Run Text="{Binding CanonicalName, Mode=OneWay}"/></TextBlock>
                        <TextBlock Opacity="0.85"><Run Text="국가/지역: "/><Run Text="{Binding Country, Mode=OneWay}"/> / <Run Text="{Binding Province, Mode=OneWay}"/> / <Run Text="{Binding City, Mode=OneWay}"/></TextBlock>
                        <TextBlock Opacity="0.85"><Run Text="Google Place: "/><Run Text="{Binding GooglePlaceIdText, Mode=OneWay}"/></TextBlock>
                        <TextBlock Opacity="0.85" TextWrapping="Wrap"><Run Text="GPS: "/><Run Text="{Binding GpsText, Mode=OneWay}"/></TextBlock>
                        <TextBlock Opacity="0.85" TextWrapping="Wrap" Text="{Binding Address, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="태그" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding Tags, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,4" CornerRadius="12" Background="{Binding ColorBrush}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12" />
                                            <Button x:ConnectionId='10' Content="×" Padding="4,0" MinWidth="24" FontSize="12"                           Tag="{Binding}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="메모" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Memo, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.9" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="EXIF 요약" FontWeight="SemiBold" />
                        <TextBlock Opacity="0.85"><Run Text="해상도: "/><Run Text="{Binding ResolutionText, Mode=OneWay}"/></TextBlock>
                        <TextBlock Opacity="0.85"><Run Text="파일크기: "/><Run Text="{Binding FileSizeText, Mode=OneWay}"/></TextBlock>
                        <Button x:ConnectionId='8'
                            Content="EXIF 전체 보기"
                                                    
                            HorizontalAlignment="Left"
                            Visibility="{Binding ShowExifDebugButton, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>

                        <Border
                            Height="200"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid>
                                <WebView2 x:ConnectionId='7' x:Name="MapWebView" />
                                <Border
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    Visibility="{Binding HasMapLocation, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Opacity="0.75"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap"
                                        Text="위치 정보 없음&#x0a;장소를 등록하면 지도에 표시됩니다." />
                                </Border>
                            </Grid>
                        </Border>

                    <TextBlock Text="같은 방문 사진" FontWeight="SemiBold" />
                    <GridView x:ConnectionId='5'
                        ItemsSource="{Binding RelatedPhotos, Mode=OneWay}"
                        IsItemClickEnabled="True"
                                                             
                        SelectionMode="None">
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Border Width="100" Height="120" Margin="2" Padding="4" CornerRadius="6"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <Grid RowDefinitions="*,Auto">
                                        <Image Stretch="UniformToFill" Source="{Binding ThumbnailImage, Mode=OneWay}" />
                                        <TextBlock Grid.Row="1" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontSize="10" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border
            Grid.Row="2"
            Padding="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        Content="📍 위치정보 추가/수정"
                        Command="{Binding OpenPlaceRegistrationCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="{Binding EmphasizePlaceRegistration, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Button
                        Content="📍 위치정보 추가/수정"
                        Command="{Binding OpenPlaceRegistrationCommand}"
                        Visibility="{Binding EmphasizePlaceRegistration, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                    <Button Content="🏷 태그관리" Command="{Binding OpenTagManagerCommand}" />
                    <Button Content="{Binding FavoriteButtonText, Mode=OneWay}" Command="{Binding ToggleFavoriteCommand}" />
                    <Button Content="📝 메모수정" Command="{Binding OpenMemoEditorCommand}" />
                    <Button Content="🌍 지도보기" Command="{Binding OpenOnMapCommand}" />
                    <Button Content="📂 원본열기" Command="{Binding OpenOriginalCommand}" />
                    <Button Content="폴더 열기" Command="{Binding OpenFileLocationCommand}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <Button Content="◀ 이전" Command="{Binding GoPreviousCommand}" IsEnabled="{Binding CanGoPrevious, Mode=OneWay}" />
            <TextBlock
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0.75"
                Text="← → 이동 · Enter 위치등록 · Esc 닫기" />
            <Button Grid.Column="2" Content="다음 ▶" Command="{Binding GoNextCommand}" IsEnabled="{Binding CanGoNext, Mode=OneWay}" />
        </Grid>
    </Grid>
</Page>

