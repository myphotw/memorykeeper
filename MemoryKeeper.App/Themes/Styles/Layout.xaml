<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="MkStandardPageContainerStyle" TargetType="Grid">
        <Setter Property="MaxWidth" Value="{StaticResource MkStandardPageMaxWidth}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="{StaticResource MkDesktopPagePaddingThickness}" />
    </Style>

    <Style x:Key="MkWidePageContainerStyle" TargetType="Grid">
        <Setter Property="MaxWidth" Value="{StaticResource MkWidePageMaxWidth}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="{StaticResource MkDesktopPagePaddingThickness}" />
    </Style>

    <Style x:Key="MkFullPageContainerStyle" TargetType="Grid">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="{StaticResource MkDesktopPagePaddingThickness}" />
    </Style>

    <Style x:Key="MkStandardStackPageContainerStyle" TargetType="StackPanel">
        <Setter Property="MaxWidth" Value="{StaticResource MkStandardPageMaxWidth}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="{StaticResource MkDesktopPagePaddingThickness}" />
    </Style>

    <Style x:Key="MkWideSettingsCardStyle" TargetType="Border" BasedOn="{StaticResource MkCardStyle}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="MkSimpleSettingsCardStyle" TargetType="Border" BasedOn="{StaticResource MkCardStyle}">
        <Setter Property="MaxWidth" Value="{StaticResource MkSettingsSimpleDetailMaxWidth}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="MkSimpleSettingsOutlinedCardStyle" TargetType="Border" BasedOn="{StaticResource MkOutlinedCardStyle}">
        <Setter Property="MaxWidth" Value="{StaticResource MkSettingsSimpleDetailMaxWidth}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
</ResourceDictionary>
