<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Photo first: cover crop + soft 12px radius -->
    <Style x:Key="MkImageStyle" TargetType="Image">
        <Setter Property="Stretch" Value="UniformToFill" />
    </Style>

    <Style x:Key="MkThumbnailBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource MkImageCornerRadius}" />
        <Setter Property="Background" Value="{ThemeResource MkBrushSurfaceMuted}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Clip" Value="{x:Null}" />
    </Style>

    <Style x:Key="MkHeroImageBorderStyle" TargetType="Border" BasedOn="{StaticResource MkThumbnailBorderStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource MkCardCornerRadius}" />
    </Style>
</ResourceDictionary>
