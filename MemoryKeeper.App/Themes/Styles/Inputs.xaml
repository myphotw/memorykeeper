<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="MkTextBoxStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource MkFontFamily}" />
        <Setter Property="MaxWidth" Value="{StaticResource MkInputMaxWidth}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="MinHeight" Value="{StaticResource MkControlHeight}" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="CornerRadius" Value="{StaticResource MkInputCornerRadius}" />
        <Setter Property="Foreground" Value="{ThemeResource MkBrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{ThemeResource MkBrushBorder}" />
        <Setter Property="Background" Value="{ThemeResource MkBrushSurface}" />
    </Style>

    <Style x:Key="MkPasswordBoxStyle" TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{StaticResource MkFontFamily}" />
        <Setter Property="MaxWidth" Value="{StaticResource MkInputMaxWidth}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="MinHeight" Value="{StaticResource MkControlHeight}" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Foreground" Value="{ThemeResource MkBrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{ThemeResource MkBrushBorder}" />
        <Setter Property="Background" Value="{ThemeResource MkBrushSurface}" />
    </Style>

    <Style x:Key="MkComboBoxStyle" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource MkFontFamily}" />
        <Setter Property="MaxWidth" Value="{StaticResource MkInputMaxWidth}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="MinHeight" Value="{StaticResource MkControlHeight}" />
        <Setter Property="CornerRadius" Value="{StaticResource MkInputCornerRadius}" />
        <Setter Property="Foreground" Value="{ThemeResource MkBrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{ThemeResource MkBrushBorder}" />
        <Setter Property="Background" Value="{ThemeResource MkBrushSurface}" />
    </Style>

    <Style x:Key="MkSearchBoxStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource MkFontFamily}" />
        <Setter Property="MaxWidth" Value="{StaticResource MkSearchMaxWidth}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="{StaticResource MkControlHeight}" />
        <Setter Property="CornerRadius" Value="{StaticResource MkInputCornerRadius}" />
        <Setter Property="Foreground" Value="{ThemeResource MkBrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{ThemeResource MkBrushBorder}" />
        <Setter Property="Background" Value="{ThemeResource MkBrushSurface}" />
    </Style>
</ResourceDictionary>
