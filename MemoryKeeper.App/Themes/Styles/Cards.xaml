<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Album-page card — white surface, 16px radius, 24px padding, no hard border.
      Attach ThemeShadow in code-behind when needed (do not share one instance).
    -->
    <Style x:Key="MkCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource MkBrushSurface}" />
        <Setter Property="BorderBrush" Value="{ThemeResource MkBrushBorder}" />
        <Setter Property="BorderThickness" Value="{StaticResource MkCardBorderThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource MkCardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource MkCardPaddingThickness}" />
        <Setter Property="Margin" Value="{StaticResource MkCardMarginThickness}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="MkOutlinedCardStyle" TargetType="Border" BasedOn="{StaticResource MkCardStyle}">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource MkBrushBorder}" />
    </Style>

    <Style x:Key="MkSuggestionPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource MkBrushSurface}" />
        <Setter Property="BorderBrush" Value="{ThemeResource MkBrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource MkInputCornerRadius}" />
        <Setter Property="Padding" Value="12,10,12,6" />
        <Setter Property="Margin" Value="0,4,0,8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="MaxHeight" Value="240" />
    </Style>

    <!-- Compact card for lists / side panels -->
    <Style x:Key="MkCompactCardStyle" TargetType="Border" BasedOn="{StaticResource MkCardStyle}">
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="{StaticResource MkComponentMarginThickness}" />
    </Style>
</ResourceDictionary>
