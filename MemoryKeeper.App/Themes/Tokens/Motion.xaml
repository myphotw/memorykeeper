<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Slow, natural motion — Fade / Opacity / Soft Slide only.
      No bounce, no snappy UI chrome.
    -->
    <x:Double x:Key="MkMotionDurationFast">180</x:Double>
    <x:Double x:Key="MkMotionDurationNormal">260</x:Double>
    <x:Double x:Key="MkMotionDurationSlow">340</x:Double>
    <x:Double x:Key="MkMotionDurationHover">280</x:Double>
</ResourceDictionary>
