<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 4px grid -->
    <x:Double x:Key="MkSpace1">4</x:Double>
    <x:Double x:Key="MkSpace2">8</x:Double>
    <x:Double x:Key="MkSpace3">12</x:Double>
    <x:Double x:Key="MkSpace4">16</x:Double>
    <x:Double x:Key="MkSpace5">20</x:Double>
    <x:Double x:Key="MkSpace6">24</x:Double>
    <x:Double x:Key="MkSpace7">28</x:Double>
    <x:Double x:Key="MkSpace8">32</x:Double>
    <x:Double x:Key="MkSpace10">40</x:Double>
    <x:Double x:Key="MkSpace12">48</x:Double>

    <!-- Semantic spacing (unified across screens) -->
    <x:Double x:Key="MkPagePadding">24</x:Double>
    <x:Double x:Key="MkCardPadding">24</x:Double>
    <x:Double x:Key="MkCardSpacing">24</x:Double>
    <x:Double x:Key="MkSectionSpacing">32</x:Double>
    <x:Double x:Key="MkComponentSpacing">16</x:Double>
    <x:Double x:Key="MkCardHeaderContentSpacing">16</x:Double>
    <x:Double x:Key="MkImageTextSpacing">16</x:Double>
    <x:Double x:Key="MkControlHeight">40</x:Double>
    <x:Double x:Key="MkSearchMaxWidth">420</x:Double>
    <x:Double x:Key="MkInputMaxWidth">560</x:Double>
    <x:Double x:Key="MkContentMaxWidth">1200</x:Double>

    <Thickness x:Key="MkPagePaddingThickness">24,20,24,28</Thickness>
    <Thickness x:Key="MkCardPaddingThickness">24</Thickness>
    <Thickness x:Key="MkCardMarginThickness">0,0,0,24</Thickness>
    <Thickness x:Key="MkLabelSpacing">0,0,0,8</Thickness>
    <Thickness x:Key="MkSectionMarginThickness">0,0,0,32</Thickness>
    <Thickness x:Key="MkComponentMarginThickness">0,0,0,16</Thickness>
    <Thickness x:Key="MkCardHeaderContentMargin">0,0,0,16</Thickness>
    <Thickness x:Key="MkImageTextMargin">0,0,0,16</Thickness>
</ResourceDictionary>
