<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Soft album-page elevation. Prefer shadow + whitespace over borders.
      Create ThemeShadow per element (do not share one instance).
    -->
    <x:Double x:Key="MkCardShadowTranslationZ">6</x:Double>
    <x:Double x:Key="MkCardHoverShadowTranslationZ">12</x:Double>

    <Thickness x:Key="MkCardBorderThickness">0</Thickness>
</ResourceDictionary>
