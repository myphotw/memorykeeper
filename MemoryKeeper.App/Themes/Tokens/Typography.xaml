<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Same font family on every screen -->
    <FontFamily x:Key="MkFontFamily">Pretendard, Noto Sans KR, Segoe UI Variable Display, Segoe UI</FontFamily>

    <!-- Outlined icon pack (Windows Fluent ≈ Material Outlined on desktop) -->
    <FontFamily x:Key="MkIconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <x:Double x:Key="MkFontSizeTitle">28</x:Double>
    <x:Double x:Key="MkFontSizeSection">20</x:Double>
    <x:Double x:Key="MkFontSizeCardTitle">17</x:Double>
    <x:Double x:Key="MkFontSizePlaceName">16</x:Double>
    <x:Double x:Key="MkFontSizeBody">15</x:Double>
    <x:Double x:Key="MkFontSizeCaption">13</x:Double>

    <x:Double x:Key="MkIconSize">20</x:Double>
    <x:Double x:Key="MkIconSizeSmall">16</x:Double>
    <x:Double x:Key="MkIconSizeLarge">24</x:Double>

    <x:Double x:Key="MkLineHeightBody">24</x:Double>
    <x:Double x:Key="MkLineHeightCaption">20</x:Double>
</ResourceDictionary>
