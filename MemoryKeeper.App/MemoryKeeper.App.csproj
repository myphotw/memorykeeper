<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
   <Version>2.0.1</Version>
   <AssemblyVersion>2.0.1.0</AssemblyVersion>
   <FileVersion>2.0.1.0</FileVersion>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>MemoryKeeper.App</RootNamespace>
    <AssemblyName>MemoryKeeper</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\MemoryKeeper.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSDKBootstrapAutoInitializeOptions_OnNoMatch_ShowUI>false</WindowsAppSDKBootstrapAutoInitializeOptions_OnNoMatch_ShowUI>
    <PublishTrimmed>false</PublishTrimmed>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <!-- GenXbf Pass2 crashes locally; sanitize loose XAML after compile. -->
    <DisableXbfGeneration>true</DisableXbfGeneration>
    <MemoryKeeperMapsCredentialFileName>MemoryKeeper.maps.key</MemoryKeeperMapsCredentialFileName>
    <MemoryKeeperMapsCredentialIntermediate>$(IntermediateOutputPath)$(MemoryKeeperMapsCredentialFileName)</MemoryKeeperMapsCredentialIntermediate>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250205002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MemoryKeeper.Application\MemoryKeeper.Application.csproj" />
    <ProjectReference Include="..\MemoryKeeper.Infrastructure\MemoryKeeper.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!-- DisableXbfGeneration can emit invalid closings like </StackPanel x:ConnectionId='n'>. -->
  <Target Name="SanitizeLooseXaml" AfterTargets="Build">
    <PropertyGroup>
      <_SanitizeRoots>$(MSBuildProjectDirectory)\$(IntermediateOutputPath);$(MSBuildProjectDirectory)\$(OutDir)</_SanitizeRoots>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\build\SanitizeLooseXaml.ps1&quot; -RootList &quot;$(_SanitizeRoots)&quot;" />
  </Target>

  <!-- Loose XAML is required at runtime when DisableXbfGeneration=true; publish omits them by default. -->
  <Target Name="CopyLooseXamlToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_LooseXamlForPublish Include="$(OutputPath)**\*.xaml"
                            Exclude="$(OutputPath)Microsoft.UI.Xaml\**\*.xaml" />
    </ItemGroup>
    <Copy SourceFiles="@(_LooseXamlForPublish)"
          DestinationFiles="@(_LooseXamlForPublish->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!--
    Deployment-only Google Maps JavaScript key. MSBuild imports the environment
    variable as a property; its value is written only under obj/bin/publish and
    is never stored in tracked appsettings or source files.
  -->
  <Target Name="GenerateMapsDeploymentCredential" BeforeTargets="Build">
    <Delete Files="$(MemoryKeeperMapsCredentialIntermediate)"
            Condition="'$(MEMORYKEEPER_GOOGLE_MAPS_JAVASCRIPT_API_KEY)' == ''" />
    <WriteLinesToFile
        File="$(MemoryKeeperMapsCredentialIntermediate)"
        Lines="$(MEMORYKEEPER_GOOGLE_MAPS_JAVASCRIPT_API_KEY)"
        Overwrite="true"
        Encoding="UTF-8"
        Condition="'$(MEMORYKEEPER_GOOGLE_MAPS_JAVASCRIPT_API_KEY)' != ''" />
  </Target>

  <Target Name="CopyMapsDeploymentCredentialToOutput"
          AfterTargets="Build"
          DependsOnTargets="GenerateMapsDeploymentCredential">
    <Delete Files="$(OutDir)$(MemoryKeeperMapsCredentialFileName)"
            Condition="'$(MEMORYKEEPER_GOOGLE_MAPS_JAVASCRIPT_API_KEY)' == ''" />
    <Copy SourceFiles="$(MemoryKeeperMapsCredentialIntermediate)"
          DestinationFiles="$(OutDir)$(MemoryKeeperMapsCredentialFileName)"
          SkipUnchangedFiles="true"
          Condition="'$(MEMORYKEEPER_GOOGLE_MAPS_JAVASCRIPT_API_KEY)' != ''" />
  </Target>

  <Target Name="CopyMapsDeploymentCredentialToPublish"
          AfterTargets="Publish"
          DependsOnTargets="GenerateMapsDeploymentCredential">
    <Delete Files="$(PublishDir)$(MemoryKeeperMapsCredentialFileName)"
            Condition="'$(MEMORYKEEPER_GOOGLE_MAPS_JAVASCRIPT_API_KEY)' == ''" />
    <Copy SourceFiles="$(MemoryKeeperMapsCredentialIntermediate)"
          DestinationFiles="$(PublishDir)$(MemoryKeeperMapsCredentialFileName)"
          SkipUnchangedFiles="true"
          Condition="'$(MEMORYKEEPER_GOOGLE_MAPS_JAVASCRIPT_API_KEY)' != ''" />
  </Target>
</Project>

