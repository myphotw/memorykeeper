<UserControl
    x:Class="MemoryKeeper.App.Views.TagManagementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="3*,2*" ColumnSpacing="20" RowSpacing="16">
        <TextBox
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Header="태그 검색"
            PlaceholderText="태그명을 입력하세요"
            Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <Border
            Grid.Row="1"
            Grid.Column="0"
            Padding="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            CornerRadius="8">
            <Grid RowDefinitions="Auto,*" RowSpacing="8">
                <TextBlock Text="등록된 태그" FontWeight="SemiBold" />
                <ListView
                    Grid.Row="1"
                    ItemsSource="{Binding Tags, Mode=OneWay}"
                    SelectedItem="{Binding SelectedTag, Mode=TwoWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="4,8" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Opacity="0.7">
                                    <Run Text="{Binding UsageCount}" />
                                    <Run Text="장" />
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <Border
            Grid.Row="1"
            Grid.Column="1"
            Padding="16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            CornerRadius="8">
            <StackPanel Spacing="12">
                <TextBlock Text="선택한 태그" FontWeight="SemiBold" />
                <TextBox
                    Header="이름"
                    Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    IsEnabled="{Binding SelectedTag.Editable, Mode=OneWay}" />
                <TextBlock Opacity="0.75">
                    <Run Text="사용 사진 " />
                    <Run Text="{Binding SelectedTag.UsageCount}" />
                    <Run Text="장" />
                </TextBlock>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        Content="이름 변경"
                        Style="{StaticResource AccentButtonStyle}"
                        IsEnabled="{Binding SelectedTag.Editable, Mode=OneWay}"
                        Click="SaveName_OnClick" />
                    <Button
                        Content="삭제"
                        IsEnabled="{Binding SelectedTag.Editable, Mode=OneWay}"
                        Click="Delete_OnClick" />
                    <Button Content="새로고침" Command="{Binding LoadCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Text="{Binding StatusMessage, Mode=OneWay}"
            TextWrapping="Wrap"
            Opacity="0.85" />
    </Grid>
</UserControl>
