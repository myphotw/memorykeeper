<Page
    x:Class="MemoryKeeper.App.Views.TravelRecordsDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MemoryKeeper.App.Models"
    xmlns:converters="using:MemoryKeeper.App.Converters"
    mc:Ignorable="d"
    Loaded="TravelRecordsDetailPage_OnLoaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <Grid ColumnDefinitions="Auto,*">
            <Button Content="뒤로" Command="{Binding BackCommand}" Margin="0,0,12,0" />
            <TextBlock
                Grid.Column="1"
                Text="{Binding Title, Mode=OneWay}"
                FontSize="28"
                FontWeight="SemiBold"
                VerticalAlignment="Center" />
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <TextBlock
                Text="{Binding StatusMessage, Mode=OneWay}"
                Opacity="0.75"
                VerticalAlignment="Center" />
            <Button
                Content="계절 방문지도 열기"
                Visibility="{Binding ShowSeasonAction, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                Command="{Binding OpenSeasonVisitRecordCommand}" />
        </StackPanel>

        <Grid Grid.Row="2">
            <ListView
                Visibility="{Binding ShowPlaces, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                ItemsSource="{Binding Places, Mode=OneWay}"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="Places_OnItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="56,72,*" ColumnSpacing="12" Padding="0,10">
                            <TextBlock Text="{Binding Rank}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Width="64" Height="64" CornerRadius="10">
                                <Image Source="{Binding ThumbnailImage, Mode=OneWay}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PlaceName}" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding VisitCountText}" Opacity="0.85" />
                                <TextBlock Text="{Binding LastVisitText}" Opacity="0.75" FontSize="12" />
                                <TextBlock Text="{Binding TagsText}" Opacity="0.7" FontSize="12" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ListView
                Visibility="{Binding ShowCountries, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                ItemsSource="{Binding Countries, Mode=OneWay}"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="Countries_OnItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="56,*" ColumnSpacing="12" Padding="0,10">
                            <TextBlock Text="{Binding Rank}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Country}" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding VisitCountText}" Opacity="0.85" />
                                <TextBlock Text="{Binding PlaceCountText}" Opacity="0.75" FontSize="12" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ListView
                Visibility="{Binding ShowFarthest, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                ItemsSource="{Binding FarthestPlaces, Mode=OneWay}"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="Farthest_OnItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="56,72,*" ColumnSpacing="12" Padding="0,10">
                            <TextBlock Text="{Binding Rank}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Width="64" Height="64" CornerRadius="10">
                                <Image Source="{Binding ThumbnailImage, Mode=OneWay}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PlaceName}" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding DistanceText}" Opacity="0.85" />
                                <TextBlock Text="{Binding YearText}" Opacity="0.75" FontSize="12" />
                                <TextBlock Text="{Binding HomeHint}" Opacity="0.7" FontSize="12" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ProgressRing
                Width="48"
                Height="48"
                IsActive="{Binding IsBusy, Mode=OneWay}"
                Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Page>
