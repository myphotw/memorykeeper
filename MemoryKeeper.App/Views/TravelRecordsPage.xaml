<Page
    x:Class="MemoryKeeper.App.Views.TravelRecordsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:MemoryKeeper.App.Converters"
    mc:Ignorable="d"
    Loaded="TravelRecordsPage_OnLoaded"
    SizeChanged="TravelRecordsPage_OnSizeChanged">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="InsightCardStyle" TargetType="Border" BasedOn="{StaticResource MkCardStyle}">
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="128" />
        </Style>

        <Style x:Key="InsightLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource MkCaptionTextStyle}">
            <Setter Property="Opacity" Value="0.72" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="InsightTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource MkPlaceNameStyle}">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
            <Setter Property="MaxLines" Value="2" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

    </Page.Resources>

    <Grid Background="{ThemeResource MkBrushBackground}">
        <ScrollViewer
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            Padding="0,0,8,0">
            <StackPanel
                x:Name="ContentHost"
                Style="{StaticResource MkStandardStackPageContainerStyle}"
                Spacing="0">

                <!-- Header -->
                <Grid Margin="0,0,0,8" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="6">
                        <TextBlock
                            Text="나의 여행"
                            Style="{StaticResource MkPageTitleStyle}"
                            Margin="0" />
                        <TextBlock
                            Text="지금까지 다녀온 여행을 한눈에 돌아보세요."
                            Style="{StaticResource MkCaptionTextStyle}"
                            Opacity="0.85" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        Text="{Binding StatusMessage, Mode=OneWay}"
                        Style="{StaticResource MkCaptionTextStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        MaxWidth="240"
                        Opacity="0.75"
                        TextWrapping="Wrap" />
                </Grid>

                <!-- Home location (existing) -->
                <Border
                    Style="{StaticResource MkCardStyle}"
                    Margin="0,0,0,24"
                    Visibility="{Binding NeedsHomeLocation, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Home Location" Style="{StaticResource MkSectionTitleStyle}" Margin="0" />
                        <TextBlock
                            Text="가장 멀리 여행한 장소를 계산하려면 집 주소를 설정해 주세요."
                            Style="{StaticResource MkCaptionTextStyle}" />
                        <TextBox
                            Style="{StaticResource MkTextBoxStyle}"
                            Header="주소 또는 장소 검색"
                            Text="{Binding HomeAddressInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Content="검색하여 저장"
                            Style="{StaticResource MkPrimaryButtonStyle}"
                            Command="{Binding SaveHomeByAddressCommand}"
                            HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <TextBlock
                    Text="{Binding HomeLocationSummary, Mode=OneWay}"
                    Style="{StaticResource MkMetaTextStyle}"
                    Margin="0,0,0,20"
                    Visibility="{Binding NeedsHomeLocation, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />

                <!-- Memory Insight -->
                <TextBlock
                    Text="Memory Insight"
                    Style="{StaticResource MkSectionTitleStyle}"
                    Margin="0,0,0,14"
                    FontSize="20" />

                <Grid
                    Margin="0,0,0,32"
                    ColumnDefinitions="*,*,*"
                    ColumnSpacing="16"
                    RowDefinitions="Auto"
                    x:Name="InsightGrid">
                    <!-- ① 최근 여행 -->
                    <Border
                        Style="{StaticResource InsightCardStyle}"
                        Tapped="RecentInsight_OnTapped"
                        PointerEntered="InsightCard_OnPointerEntered"
                        PointerExited="InsightCard_OnPointerExited">
                        <StackPanel Spacing="4">
                            <TextBlock Text="최근 여행" Style="{StaticResource InsightLabelStyle}" />
                            <TextBlock
                                x:Name="InsightRecentPlace"
                                Text="—"
                                Style="{StaticResource InsightTitleStyle}" />
                            <TextBlock
                                x:Name="InsightRecentDate"
                                Text=""
                                Style="{StaticResource MkMetaTextStyle}" />
                        </StackPanel>
                    </Border>

                    <!-- ② 가장 오래 안 간 곳 -->
                    <Border
                        Grid.Column="1"
                        Style="{StaticResource InsightCardStyle}"
                        Visibility="{Binding HasLongUnvisited, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        Tapped="LongUnvisited_OnTapped"
                        PointerEntered="InsightCard_OnPointerEntered"
                        PointerExited="InsightCard_OnPointerExited">
                        <StackPanel Spacing="4">
                            <TextBlock Text="가장 오래 안 간 곳" Style="{StaticResource InsightLabelStyle}" />
                            <TextBlock
                                Text="{Binding LongUnvisitedPlace.PlaceName, Mode=OneWay}"
                                Style="{StaticResource InsightTitleStyle}" />
                            <TextBlock
                                Text="{Binding LongUnvisitedPlace.LastVisitText, Mode=OneWay}"
                                Style="{StaticResource MkMetaTextStyle}" />
                            <TextBlock
                                Text="{Binding LongUnvisitedPlace.RelativeText, Mode=OneWay}"
                                Style="{StaticResource MkCaptionTextStyle}"
                                Opacity="0.8" />
                        </StackPanel>
                    </Border>
                    <Border
                        Grid.Column="1"
                        Style="{StaticResource InsightCardStyle}"
                        Visibility="{Binding HasLongUnvisited, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="가장 오래 안 간 곳" Style="{StaticResource InsightLabelStyle}" />
                            <TextBlock Text="아직 기록이 없어요" Style="{StaticResource InsightTitleStyle}" Opacity="0.55" />
                        </StackPanel>
                    </Border>

                    <!-- ③ 가장 멀리 간 여행 -->
                    <Border
                        Grid.Column="2"
                        Style="{StaticResource InsightCardStyle}"
                        Visibility="{Binding HasFarthest, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        Tapped="Farthest_OnTapped"
                        PointerEntered="InsightCard_OnPointerEntered"
                        PointerExited="InsightCard_OnPointerExited">
                        <StackPanel Spacing="4">
                            <TextBlock Text="가장 멀리 간 여행" Style="{StaticResource InsightLabelStyle}" />
                            <TextBlock
                                Text="{Binding FarthestPlace.PlaceName, Mode=OneWay}"
                                Style="{StaticResource InsightTitleStyle}" />
                            <TextBlock
                                Text="{Binding FarthestPlace.DistanceText, Mode=OneWay}"
                                Style="{StaticResource MkMetaTextStyle}" />
                        </StackPanel>
                    </Border>
                    <Border
                        Grid.Column="2"
                        Style="{StaticResource InsightCardStyle}"
                        Visibility="{Binding HasFarthest, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="가장 멀리 간 여행" Style="{StaticResource InsightLabelStyle}" />
                            <TextBlock Text="{Binding FarthestEmptyMessage, Mode=OneWay}" Style="{StaticResource InsightTitleStyle}" Opacity="0.55" />
                        </StackPanel>
                    </Border>

                </Grid>

                <!-- Existing summary statistics -->
                <StackPanel
                    x:Name="StatsHost"
                    Margin="0,0,0,32"
                    Spacing="12"
                    Visibility="Collapsed">
                    <TextBlock
                        Text="여행 한눈에"
                        Style="{StaticResource MkSectionTitleStyle}"
                        FontSize="18"
                        Margin="0,0,0,4" />
                    <TextBlock Text="해외" Style="{StaticResource MkCaptionTextStyle}" FontWeight="SemiBold" Opacity="0.75" />
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="해외여행 횟수" Style="{StaticResource MkCaptionTextStyle}" Opacity="0.7" />
                            <TextBlock x:Name="StatForeignTrips" Style="{StaticResource MkPlaceNameStyle}" FontSize="22" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <Button
                                AutomationProperties.Name="해외 방문 국가 사진첩에서 보기"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding OpenForeignCountriesCommand}"
                                HorizontalAlignment="Left"
                                Padding="0">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="해외 방문 국가" Style="{StaticResource MkCaptionTextStyle}" Opacity="0.7" />
                                    <TextBlock x:Name="StatCountries" Style="{StaticResource MkPlaceNameStyle}" FontSize="22" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            AutomationProperties.Name="해외 방문 장소 사진첩에서 보기"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding OpenForeignPlacesCommand}"
                            HorizontalAlignment="Left"
                            Padding="0">
                            <StackPanel Spacing="4">
                                <TextBlock Text="해외 방문 장소" Style="{StaticResource MkCaptionTextStyle}" Opacity="0.7" />
                                <TextBlock x:Name="StatForeignPlaces" Style="{StaticResource MkPlaceNameStyle}" FontSize="22" />
                            </StackPanel>
                        </Button>
                        <Button
                            Grid.Column="3"
                            AutomationProperties.Name="해외 사진 사진첩에서 보기"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding OpenForeignPhotosCommand}"
                            HorizontalAlignment="Left"
                            Padding="0">
                            <StackPanel Spacing="4">
                                <TextBlock Text="해외 사진" Style="{StaticResource MkCaptionTextStyle}" Opacity="0.7" />
                                <TextBlock x:Name="StatForeignPhotos" Style="{StaticResource MkPlaceNameStyle}" FontSize="22" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock Text="국내" Style="{StaticResource MkCaptionTextStyle}" FontWeight="SemiBold" Opacity="0.75" Margin="0,8,0,0" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="국내여행 횟수" Style="{StaticResource MkCaptionTextStyle}" Opacity="0.7" />
                            <TextBlock x:Name="StatDomesticTrips" Style="{StaticResource MkPlaceNameStyle}" FontSize="22" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            AutomationProperties.Name="국내 방문 장소 사진첩에서 보기"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding OpenDomesticPlacesCommand}"
                            HorizontalAlignment="Left"
                            Padding="0">
                            <StackPanel Spacing="4">
                                <TextBlock Text="국내 방문 장소" Style="{StaticResource MkCaptionTextStyle}" Opacity="0.7" />
                                <TextBlock x:Name="StatDomesticPlaces" Style="{StaticResource MkPlaceNameStyle}" FontSize="22" />
                            </StackPanel>
                        </Button>
                        <Button
                            Grid.Column="2"
                            AutomationProperties.Name="국내 사진 사진첩에서 보기"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding OpenDomesticPhotosCommand}"
                            HorizontalAlignment="Left"
                            Padding="0">
                            <StackPanel Spacing="4">
                                <TextBlock Text="국내 사진" Style="{StaticResource MkCaptionTextStyle}" Opacity="0.7" />
                                <TextBlock x:Name="StatDomesticPhotos" Style="{StaticResource MkPlaceNameStyle}" FontSize="22" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- Country visit graph: consecutive capture-date ranges per country -->
                <TextBlock
                    Text="국가별 방문 횟수"
                    Style="{StaticResource MkSectionTitleStyle}"
                    Margin="0,0,0,6"
                    FontSize="20" />
                <TextBlock
                    Text="같은 나라에서 연속된 날짜의 사진은 한 번의 방문으로 계산했어요."
                    Style="{StaticResource MkCaptionTextStyle}"
                    Margin="0,0,0,14"
                    Opacity="0.8" />
                <Border
                    Style="{StaticResource MkCardStyle}"
                    Margin="0,0,0,32"
                    Visibility="{Binding HasCountryVisitStatistics, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding CountryVisitStatistics, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="140,*,Auto" ColumnSpacing="14" Margin="0,6">
                                        <TextBlock
                                            Text="{Binding Country, Mode=OneWay}"
                                            Style="{StaticResource MkBodyTextStyle}"
                                            FontWeight="SemiBold"
                                            TextTrimming="CharacterEllipsis"
                                            VerticalAlignment="Center" />
                                        <ProgressBar
                                            Grid.Column="1"
                                            Minimum="0"
                                            Maximum="{Binding MaximumVisitCount, Mode=OneWay}"
                                            Value="{Binding VisitCount, Mode=OneWay}"
                                            Height="8"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{Binding VisitCountText, Mode=OneWay}"
                                            Style="{StaticResource MkMetaTextStyle}"
                                            MinWidth="42"
                                            TextAlignment="Right"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
                <Border
                    Style="{StaticResource MkEmptyStateCardStyle}"
                    Margin="0,0,0,32"
                    Visibility="{Binding HasCountryVisitStatistics, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                    <TextBlock
                        Text="촬영 날짜와 국가 정보가 있는 사진이 쌓이면 방문 횟수를 보여드려요."
                        Style="{StaticResource MkEmptyStateMessageStyle}" />
                </Border>

                <!-- MemoryKeeper-selected memories -->
                <TextBlock
                    Text="MemoryKeeper가 꺼내본 추억"
                    Style="{StaticResource MkSectionTitleStyle}"
                    Margin="0,0,0,6"
                    FontSize="20" />
                <TextBlock
                    Text="오늘과 비슷한 시기의 사진을 골라 먼저 보여드려요."
                    Style="{StaticResource MkCaptionTextStyle}"
                    Margin="0,0,0,16"
                    Opacity="0.8" />

                <!-- Home FeaturedMemory is preserved inside the new memory area. -->
                <Border
                    Margin="0,0,0,16"
                    Padding="16,12"
                    CornerRadius="12"
                    Background="{ThemeResource MkBrushSurface}"
                    BorderBrush="{ThemeResource MkBrushAccentGoldMuted}"
                    BorderThickness="1"
                    Visibility="{Binding HasFeaturedMemory, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                    Tapped="FeaturedMemory_OnTapped"
                    PointerEntered="InsightCard_OnPointerEntered"
                    PointerExited="InsightCard_OnPointerExited">
                    <StackPanel Spacing="4">
                        <TextBlock
                            Text="{Binding FeaturedMemoryCaption, Mode=OneWay}"
                            Style="{StaticResource MkCaptionTextStyle}"
                            Opacity="0.8" />
                        <TextBlock
                            Text="{Binding FeaturedMemory.TripName, Mode=OneWay}"
                            Style="{StaticResource MkPlaceNameStyle}" />
                        <TextBlock
                            Text="{Binding FeaturedMemory.PeriodText, Mode=OneWay}"
                            Style="{StaticResource MkMetaTextStyle}" />
                    </StackPanel>
                </Border>

                <GridView
                    x:Name="MemoryCardsGrid"
                    ItemsSource="{Binding MemoryCards, Mode=OneWay}"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="MemoryCard_OnItemClick"
                    ContainerContentChanging="MemoryCardsGrid_OnContainerContentChanging"
                    SizeChanged="MemoryCardsGrid_OnSizeChanged"
                    Margin="0,0,0,20"
                    Visibility="{Binding HasMemoryCards, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Margin" Value="0,0,14,14" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource MkCardStyle}" MinHeight="190">
                                <StackPanel Spacing="10">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding Title, Mode=OneWay}" Style="{StaticResource MkPlaceNameStyle}" FontSize="18" />
                                        <TextBlock Text="{Binding Subtitle, Mode=OneWay}" Style="{StaticResource MkMetaTextStyle}" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Photos, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="88" Height="88" CornerRadius="8" Background="{ThemeResource MkBrushSurfaceMuted}">
                                                    <Image
                                                        Source="{Binding ThumbnailImage, Mode=OneWay}"
                                                        Stretch="UniformToFill"
                                                        AutomationProperties.Name="{Binding AccessibleLabel, Mode=OneWay}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock
                                        Text="{Binding PlaceSummary, Mode=OneWay}"
                                        Style="{StaticResource MkCaptionTextStyle}"
                                        Opacity="0.8"
                                        TextTrimming="CharacterEllipsis"
                                        MaxLines="1" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <Border
                    Style="{StaticResource MkEmptyStateCardStyle}"
                    Visibility="{Binding HasMemoryCards, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <TextBlock
                            Text="아직 꺼내볼 수 있는 과거 추억이 없습니다."
                            Style="{StaticResource MkEmptyStateTitleStyle}" />
                        <TextBlock
                            Text="촬영 날짜가 있는 사진을 가져오면 오늘과 비슷한 시기의 추억을 골라드려요."
                            Style="{StaticResource MkEmptyStateMessageStyle}" />
                        <Button
                            Content="사진 가져오기"
                            Style="{StaticResource MkPrimaryButtonStyle}"
                            MinWidth="200"
                            HorizontalAlignment="Center"
                            Click="ImportPhotos_OnClick" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <ProgressRing
            Width="48"
            Height="48"
            IsActive="{Binding IsBusy, Mode=OneWay}"
            Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />
    </Grid>
</Page>
