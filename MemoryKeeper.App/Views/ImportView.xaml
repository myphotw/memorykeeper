<UserControl

    x:Class="MemoryKeeper.App.Views.ImportView"

    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

    xmlns:converters="using:MemoryKeeper.App.Converters"

    mc:Ignorable="d">



    <UserControl.Resources>

        <converters:BoolNegationConverter x:Key="BoolNegationConverter" />

    </UserControl.Resources>



    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="16">
        <StackPanel x:Name="StoragePathPanel" Spacing="4">

            <TextBlock Text="MemoryKeeper 저장소" FontWeight="SemiBold" />

            <TextBlock

                Text="{Binding MemoryKeeperStoragePath, Mode=OneWay}"

                TextWrapping="Wrap"

                Opacity="0.85"

                IsTextSelectionEnabled="True" />

        </StackPanel>



        <Grid
            x:Name="SourceFolderPanel"
            Grid.Row="1"
            MaxWidth="{StaticResource MkInputMaxWidth}"
            HorizontalAlignment="Left"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="8">
            <TextBox
                Style="{StaticResource MkTextBoxStyle}"
                Header="등록할 폴더"
                Text="{Binding SourceFolderPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                IsReadOnly="True" />
            <Button
                Grid.Column="1"
                Content="폴더 선택"
                Style="{StaticResource MkButtonStyle}"
                VerticalAlignment="Bottom"
                Command="{Binding BrowseFolderCommand}"
                IsEnabled="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}" />
        </Grid>



        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">

            <Button

                Content="사진 등록 시작"

                Style="{StaticResource AccentButtonStyle}"

                Command="{Binding ImportCommand}"

                IsEnabled="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}" />

            <Button

                Content="취소"

                Command="{Binding CancelImportCommand}"

                IsEnabled="{Binding IsBusy, Mode=OneWay}" />

        </StackPanel>



        <Grid Grid.Row="3" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">

            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="등록 진행" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding ProgressCountText, Mode=OneWay}" FontWeight="SemiBold" />
            </Grid>

            <ProgressBar
                Grid.Row="1"
                Minimum="0"
                Maximum="1"
                Value="{Binding ProgressValue, Mode=OneWay}"
                Height="8" />

            <TextBlock
                Grid.Row="2"
                Text="{Binding CurrentStage, Mode=OneWay}"
                FontWeight="SemiBold"
                Opacity="0.85" />

            <Grid Grid.Row="3" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Border Padding="12,10" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <TextBlock Text="{Binding RegisteredCountText, Mode=OneWay}" FontWeight="SemiBold" />
                </Border>
                <Border Grid.Column="1" Padding="12,10" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <TextBlock Text="{Binding DuplicateCountText, Mode=OneWay}" FontWeight="SemiBold" />
                </Border>
                <Border Grid.Column="2" Padding="12,10" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <TextBlock Text="{Binding FailedCountText, Mode=OneWay}" FontWeight="SemiBold" />
                </Border>
            </Grid>

            <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="16">
                <TextBlock Text="{Binding UploadProgressText, Mode=OneWay}" Opacity="0.75" />
                <TextBlock Text="{Binding WaitingCountText, Mode=OneWay}" Opacity="0.75" />
                <TextBlock Text="{Binding ProcessingCountText, Mode=OneWay}" Opacity="0.75" />
                <TextBlock Text="{Binding AnalysisProgressText, Mode=OneWay}" Opacity="0.75" />
            </StackPanel>

            <StackPanel Grid.Row="5" Spacing="2">
                <TextBlock Text="현재 파일" Opacity="0.65" FontSize="12" />
                <TextBlock
                    Text="{Binding CurrentFileName, Mode=OneWay}"
                    Opacity="0.75"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Button
                Grid.Row="6"
                Content="실패 항목 다시 시도"
                Command="{Binding RetryImportCommand}"
                IsEnabled="{Binding IsRetryReady, Mode=OneWay}"
                HorizontalAlignment="Left"
                Padding="10,4" />
        </Grid>

        <TextBlock
            Grid.Row="4"
            Text="{Binding StatusMessage, Mode=OneWay}"
            TextWrapping="Wrap"
            VerticalAlignment="Top"
            Opacity="0.85" />
    </Grid>
</UserControl>


