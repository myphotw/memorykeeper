<UserControl
    x:Class="MemoryKeeper.App.Views.PendingMemoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MemoryKeeper.App.Models"
    xmlns:converters="using:MemoryKeeper.App.Converters"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:BoolNegationConverter x:Key="BoolNegationConverter" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*" RowSpacing="12">
        <ScrollViewer
            Grid.Row="0"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Disabled"
            IsHitTestVisible="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}">
            <StackPanel Orientation="Horizontal" Spacing="8" MinWidth="520">
                <TextBlock
                    Text="{Binding StatusMessage, Mode=OneWay}"
                    VerticalAlignment="Center"
                    TextWrapping="NoWrap"
                    TextTrimming="CharacterEllipsis"
                    Opacity="0.85"
                    MaxWidth="220"
                    MinWidth="80" />

                <Button
                    Content="새로고침"
                    Style="{StaticResource MkButtonStyle}"
                    VerticalAlignment="Center"
                    Command="{Binding LoadCommand}"
                    MinWidth="88" />

                <TextBlock
                    Text="{Binding ActiveGroupPhotoProgressText, Mode=OneWay}"
                    VerticalAlignment="Center"
                    Opacity="0.8" />

                <Button
                    Content="사진 더 보기"
                    Style="{StaticResource MkButtonStyle}"
                    VerticalAlignment="Center"
                    Command="{Binding LoadMoreGroupPhotosCommand}"
                    Visibility="{Binding CanLoadMoreGroupPhotos, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="{Binding IsPlaceMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button
                        Content="장소등록"
                        Style="{StaticResource AccentButtonStyle}"
                        MinHeight="40"
                        Command="{Binding OpenPlaceRegistrationCommand}"
                        MinWidth="96" />
                    <ComboBox
                        PlaceholderText="기존 장소"
                        ItemsSource="{Binding Places, Mode=OneWay}"
                        SelectedItem="{Binding SelectedPlace, Mode=TwoWay}"
                        DisplayMemberPath="DisplayName"
                        MinHeight="40"
                        Width="180" />
                    <Button
                        Content="일괄 등록"
                        Style="{StaticResource AccentButtonStyle}"
                        MinHeight="40"
                        Command="{Binding AssignPlaceCommand}"
                        MinWidth="96" />
                </StackPanel>

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="{Binding IsCaptureDateMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button
                        Content="촬영일 변경"
                        Style="{StaticResource AccentButtonStyle}"
                        MinHeight="40"
                        Command="{Binding OpenCaptureDateEditorCommand}" />
                    <Button
                        Content="촬영일 보정 해제"
                        Style="{StaticResource MkButtonStyle}"
                        MinHeight="40"
                        Command="{Binding RequestClearCaptureDateCommand}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid
            Grid.Row="1"
            ColumnDefinitions="0.35*,0.65*"
            ColumnSpacing="12"
            MinWidth="480"
            IsHitTestVisible="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}">
            <!-- Backend-authoritative Place and Capture-Date work queues (5 + 5). -->
            <Grid RowDefinitions="Auto,*,Auto,Auto,*,Auto" RowSpacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="장소 정리 그룹" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding PlaceQueueSummaryText, Mode=OneWay}" FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
                </StackPanel>

                <ListView
                    Grid.Row="1"
                    ItemsSource="{Binding PlaceGroups, Mode=OneWay}"
                    SelectedItem="{Binding SelectedPlaceGroup, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:PlaceCleanupGroupItem">
                            <Border Padding="8" CornerRadius="6" Background="Transparent">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding CountText, Mode=OneWay}" FontSize="12" Opacity="0.85" />
                                    <TextBlock Text="{Binding PeriodText, Mode=OneWay}" FontSize="11" Opacity="0.7" />
                                    <TextBlock Text="{Binding LocationText, Mode=OneWay}" FontSize="11" Opacity="0.75" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding IssueStatusText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Button
                    Grid.Row="2"
                    Content="다음 장소 그룹"
                    HorizontalAlignment="Stretch"
                    Command="{Binding LoadMorePlaceGroupsCommand}"
                    Visibility="{Binding CanLoadMorePlaceGroups, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                    <TextBlock Text="날짜 정리 그룹" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CaptureDateQueueSummaryText, Mode=OneWay}" FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
                </StackPanel>

                <ListView
                    Grid.Row="4"
                    ItemsSource="{Binding CaptureDateGroups, Mode=OneWay}"
                    SelectedItem="{Binding SelectedCaptureDateGroup, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:CaptureDateCleanupGroupItem">
                            <Border Padding="8" CornerRadius="6" Background="Transparent">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding CountText, Mode=OneWay}" FontSize="12" Opacity="0.85" />
                                    <TextBlock Text="{Binding ReasonText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding DateSummaryText, Mode=OneWay}" FontSize="11" Opacity="0.75" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding PeriodText, Mode=OneWay}" FontSize="11" Opacity="0.7" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Button
                    Grid.Row="5"
                    Content="다음 날짜 그룹"
                    HorizontalAlignment="Stretch"
                    Command="{Binding LoadMoreCaptureDateGroupsCommand}"
                    Visibility="{Binding CanLoadMoreCaptureDateGroups, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>

            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="전체 보기" Command="{Binding SelectAllCleanupCommand}" />
                    <Button Content="전체 포함" Command="{Binding IncludeAllCommand}" />
                    <Button Content="전체 제외" Command="{Binding ExcludeAllCommand}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Opacity="0.8"
                        Text="{Binding IncludedCount, Mode=OneWay}" />
                    <TextBlock VerticalAlignment="Center" Opacity="0.8" Text="장 선택됨" />
                </StackPanel>

                <TextBlock
                    Grid.Row="1"
                    Text="{Binding ActiveMediaSectionTitle, Mode=OneWay}"
                    FontWeight="SemiBold" />

                <GridView
                    Grid.Row="2"
                    ItemsSource="{Binding ActiveMediaItems, Mode=OneWay}"
                    SelectionMode="None">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Width="232"
                                Height="320"
                                Margin="6"
                                Padding="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Grid RowDefinitions="*,Auto,Auto" RowSpacing="6">
                                    <Border
                                        MinHeight="220"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="4"
                                        Tapped="PendingMedia_OnTapped"
                                        Tag="{Binding}">
                                        <Grid>
                                            <ProgressRing
                                                Width="24"
                                                Height="24"
                                                IsActive="{Binding IsThumbnailLoading, Mode=OneWay}"
                                                Visibility="{Binding IsThumbnailLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <Image
                                                Stretch="Uniform"
                                                Source="{Binding ThumbnailImage, Mode=OneWay}" />
                                            <Border
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Margin="4"
                                                Padding="6,2"
                                                CornerRadius="4"
                                                Background="#B33A2E">
                                                <TextBlock Text="정리 필요" Foreground="White" FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                            <Border
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="4"
                                                Padding="5,1"
                                                CornerRadius="4"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                                <CheckBox
                                                    Content="포함"
                                                    Tapped="IncludeCheckBox_OnTapped"
                                                    IsChecked="{Binding IsIncluded, Mode=TwoWay}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Row="1" Spacing="2">
                                        <TextBlock
                                            Text="{Binding CapturedAtText}"
                                            Opacity="0.75"
                                            FontSize="11" />
                                        <TextBlock
                                            Text="{Binding StatusSummaryText}"
                                            FontSize="11"
                                            Opacity="0.9" />
                                        <TextBlock
                                            Text="{Binding GeographyText}"
                                            FontSize="11"
                                            Opacity="0.75"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Text="{Binding DateBasisText}"
                                            FontSize="11"
                                            Opacity="0.75" />
                                    </StackPanel>
                                    <Button
                                        Grid.Row="2"
                                        Content="상세"
                                        HorizontalAlignment="Stretch"
                                        Click="PendingMediaDetail_OnClick"
                                        Tag="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <Border
                    Grid.Row="3"
                    Padding="12,10"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="8"
                    Visibility="{Binding HasSelectionForActions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button
                            Content="장소등록"
                            Style="{StaticResource AccentButtonStyle}"
                            MinHeight="40"
                            VerticalAlignment="Center"
                            Command="{Binding OpenPlaceRegistrationCommand}"
                            Visibility="{Binding IsPlaceMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <Button
                            Content="촬영일 변경"
                            Style="{StaticResource AccentButtonStyle}"
                            MinHeight="40"
                            Command="{Binding OpenCaptureDateEditorCommand}"
                            Visibility="{Binding IsCaptureDateMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <Button
                            Content="촬영일 보정 해제"
                            Style="{StaticResource MkButtonStyle}"
                            Command="{Binding RequestClearCaptureDateCommand}"
                            Visibility="{Binding IsCaptureDateMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <Button
                            Content="메모"
                            Style="{StaticResource MkButtonStyle}"
                            VerticalAlignment="Center"
                            Command="{Binding OpenMemoCommand}" />
                        <Button
                            Content="즐겨찾기"
                            Style="{StaticResource MkButtonStyle}"
                            VerticalAlignment="Center"
                            Command="{Binding ToggleFavoriteCommand}" />
                        <Button
                            Content="태그등록"
                            Style="{StaticResource MkButtonStyle}"
                            VerticalAlignment="Center"
                            Command="{Binding OpenSelectedPhotoDetailCommand}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Border
            Grid.RowSpan="2"
            Background="#33000000"
            Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
            Canvas.ZIndex="10">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <ProgressRing IsActive="True" Width="36" Height="36" />
                <TextBlock Text="잠시 기다려 주세요" FontWeight="SemiBold" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
