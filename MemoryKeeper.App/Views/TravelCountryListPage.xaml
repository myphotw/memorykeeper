<Page
    x:Class="MemoryKeeper.App.Views.TravelCountryListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MemoryKeeper.App.Converters"
    xmlns:models="using:MemoryKeeper.App.Models"
    Loaded="TravelCountryListPage_OnLoaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style x:Key="TravelCountryListItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <Grid Style="{StaticResource MkStandardPageContainerStyle}" RowDefinitions="Auto,Auto,*" RowSpacing="16">
        <StackPanel Spacing="6">
            <Button Command="{Binding GoBackCommand}" Style="{StaticResource MkBackNavigationButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontFamily="{StaticResource MkIconFontFamily}" FontSize="14" Glyph="&#xE72B;" />
                    <TextBlock Text="여행기록" />
                </StackPanel>
            </Button>
            <TextBlock Text="해외 방문 국가" Style="{StaticResource MkPageTitleStyle}" Margin="0" />
        </StackPanel>

        <TextBlock
            Grid.Row="1"
            Text="{Binding StatusMessage}"
            Style="{StaticResource MkCaptionTextStyle}"
            Opacity="0.8" />

        <Grid Grid.Row="2">
            <ListView
                ItemsSource="{Binding Countries}"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="Countries_OnItemClick"
                ItemContainerStyle="{StaticResource TravelCountryListItemStyle}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:TravelForeignCountryItem">
                        <Border Style="{StaticResource MkCompactCardStyle}">
                            <Grid ColumnDefinitions="84,*" ColumnSpacing="16">
                                <Border Width="84" Height="84" Style="{StaticResource MkThumbnailBorderStyle}">
                                    <Image Source="{Binding ThumbnailImage}" Style="{StaticResource MkImageStyle}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Country}" Style="{StaticResource MkPlaceNameStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{Binding VisitCountText}" Style="{StaticResource MkMetaTextStyle}" />
                                        <TextBlock Text="·" Style="{StaticResource MkMetaTextStyle}" />
                                        <TextBlock Text="{Binding PhotoCountText}" Style="{StaticResource MkMetaTextStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <ProgressRing
                Width="48"
                Height="48"
                IsActive="{Binding IsBusy}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Page>
