<Page
    x:Class="MemoryKeeper.App.Views.VisitRecordPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MemoryKeeper.App.Models"
    xmlns:converters="using:MemoryKeeper.App.Converters"
    mc:Ignorable="d"
    Loaded="VisitRecordPage_OnLoaded"
    Unloaded="VisitRecordPage_OnUnloaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="YearTitleButtonStyle" TargetType="Button" BasedOn="{StaticResource MkTextButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="8,8" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="PlaceRowCardStyle" TargetType="Border" BasedOn="{StaticResource MkCompactCardStyle}">
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource MkBrushBackground}">
        <!-- Main layout (suggestions do not participate — overlay sibling below) -->
        <Grid
            RowDefinitions="Auto,*,Auto"
            RowSpacing="{StaticResource MkSectionSpacing}"
            Padding="{StaticResource MkPagePaddingThickness}">

            <!-- Title + fixed-width search (no expanding result row) -->
            <StackPanel Spacing="12">
                <TextBlock
                    Text="방문지도"
                    Style="{StaticResource MkPageTitleStyle}"
                    Margin="0" />
                <TextBlock
                    Text="{Binding StatusMessage, Mode=OneWay}"
                    Style="{StaticResource MkCaptionTextStyle}"
                    Opacity="0.8" />

                <Grid
                    x:Name="SearchRow"
                    Width="520"
                    HorizontalAlignment="Left"
                    ColumnDefinitions="*,Auto,Auto"
                    ColumnSpacing="8">
                    <TextBox
                        x:Name="SearchBox"
                        Style="{StaticResource MkSearchBoxStyle}"
                        PlaceholderText="오사카 맛집, 작년 벚꽃, 즐겨찾기 음식..."
                        Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        KeyDown="SearchBox_OnKeyDown"
                        GotFocus="SearchBox_OnGotFocus"
                        LostFocus="SearchBox_OnLostFocus" />
                    <Button
                        Grid.Column="1"
                        Content="⌕"
                        Width="48"
                        MinHeight="40"
                        Style="{StaticResource MkPrimaryButtonStyle}"
                        Command="{Binding SearchCommand}" />
                    <Button
                        Grid.Column="2"
                        Content="최근"
                        Width="64"
                        MinHeight="40"
                        Style="{StaticResource MkSecondaryButtonStyle}"
                        Command="{Binding ShowRecentCommand}" />
                </Grid>

                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxHeight="36">
                    <ItemsControl ItemsSource="{Binding SearchChips, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,4" CornerRadius="12" Background="{ThemeResource MkBrushPrimary}">
                                    <TextBlock
                                        Text="{Binding DisplayLabel}"
                                        Foreground="{ThemeResource MkBrushTextOnPrimary}"
                                        FontSize="12" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

        <!-- Body: Year list | Map (map is the focus) -->
        <Grid
            x:Name="BodyGrid"
            Grid.Row="1"
            ColumnDefinitions="0.28*,0.72*"
            ColumnSpacing="16"
            MinWidth="0">

            <Grid x:Name="TimelinePane" RowDefinitions="Auto,*" RowSpacing="12">
                <Grid x:Name="TimelineToolbarHost">
                    <StackPanel x:Name="ToolbarLarge" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                        <Button Content="전체 펼치기" Command="{Binding ExpandAllCommand}" Style="{StaticResource MkSecondaryButtonStyle}" MinWidth="88" Padding="10,6" />
                        <Button Content="전체 접기" Command="{Binding CollapseAllCommand}" Style="{StaticResource MkSecondaryButtonStyle}" MinWidth="80" Padding="10,6" />
                        <Button Content="최근순" Command="{Binding SortByRecentCommand}" Style="{StaticResource MkSecondaryButtonStyle}" MinWidth="64" Padding="10,6" />
                        <Button Content="이름순" Command="{Binding SortByNameCommand}" Style="{StaticResource MkSecondaryButtonStyle}" MinWidth="64" Padding="10,6" />
                        <Button Content="방문횟수순" Command="{Binding SortByVisitCountCommand}" Style="{StaticResource MkSecondaryButtonStyle}" MinWidth="88" Padding="10,6" />
                    </StackPanel>
                    <StackPanel x:Name="ToolbarMedium" Spacing="6" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="전체 펼치기" Command="{Binding ExpandAllCommand}" Style="{StaticResource MkSecondaryButtonStyle}" MinWidth="88" Padding="10,6" />
                            <Button Content="전체 접기" Command="{Binding CollapseAllCommand}" Style="{StaticResource MkSecondaryButtonStyle}" MinWidth="80" Padding="10,6" />
                            <Button Content="최근순" Command="{Binding SortByRecentCommand}" Style="{StaticResource MkSecondaryButtonStyle}" MinWidth="64" Padding="10,6" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="이름순" Command="{Binding SortByNameCommand}" Style="{StaticResource MkSecondaryButtonStyle}" MinWidth="64" Padding="10,6" />
                            <Button Content="방문횟수순" Command="{Binding SortByVisitCountCommand}" Style="{StaticResource MkSecondaryButtonStyle}" MinWidth="88" Padding="10,6" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="ToolbarSmall" Spacing="6" Visibility="Visible">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="전체 펼치기" Command="{Binding ExpandAllCommand}" Style="{StaticResource MkSecondaryButtonStyle}" MinWidth="88" Padding="10,6" />
                            <Button Content="전체 접기" Command="{Binding CollapseAllCommand}" Style="{StaticResource MkSecondaryButtonStyle}" MinWidth="80" Padding="10,6" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="최근순" Command="{Binding SortByRecentCommand}" Style="{StaticResource MkSecondaryButtonStyle}" MinWidth="64" Padding="10,6" />
                            <Button Content="이름순" Command="{Binding SortByNameCommand}" Style="{StaticResource MkSecondaryButtonStyle}" MinWidth="64" Padding="10,6" />
                            <Button Content="방문횟수순" Command="{Binding SortByVisitCountCommand}" Style="{StaticResource MkSecondaryButtonStyle}" MinWidth="88" Padding="10,6" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <ListView
                    x:Name="TimelineList"
                    Grid.Row="1"
                    ItemsSource="{Binding VisibleTreeNodes, Mode=OneWay}"
                    SelectionMode="None"
                    Visibility="{Binding HasNoResults, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="{Binding IndentMargin, Mode=OneWay}" ColumnDefinitions="Auto,*" ColumnSpacing="2">
                                <Button
                                    Grid.Column="0"
                                    Content="{Binding ExpandGlyph, Mode=OneWay}"
                                    Padding="4,2"
                                    MinWidth="24"
                                    Style="{StaticResource YearTitleButtonStyle}"
                                    Click="HierarchyExpand_OnClick"
                                    Tag="{Binding}"
                                    Visibility="{Binding CanExpand, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Button
                                    Grid.Column="1"
                                    Style="{StaticResource YearTitleButtonStyle}"
                                    Content="{Binding DisplayLabel, Mode=OneWay}"
                                    Click="HierarchyNode_OnClick"
                                    Tag="{Binding}"
                                    Foreground="{ThemeResource MkBrushPrimary}"
                                    FontWeight="SemiBold"
                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Button
                                    Grid.Column="1"
                                    Style="{StaticResource YearTitleButtonStyle}"
                                    Content="{Binding DisplayLabel, Mode=OneWay}"
                                    Click="HierarchyNode_OnClick"
                                    Tag="{Binding}"
                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Border
                    Grid.Row="1"
                    Style="{StaticResource MkEmptyStateCardStyle}"
                    HorizontalAlignment="Stretch"
                    MaxWidth="360"
                    Visibility="{Binding HasNoResults, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="아직 방문 기록이 없습니다." Style="{StaticResource MkEmptyStateTitleStyle}" />
                        <TextBlock
                            Text="사진을 가져오고 장소를 연결하면 지도에 추억이 표시됩니다."
                            Style="{StaticResource MkEmptyStateMessageStyle}" />
                        <Button
                            Content="사진 가져오기"
                            Style="{StaticResource MkPrimaryButtonStyle}"
                            HorizontalAlignment="Center"
                            MinWidth="180"
                            Click="ImportPhotos_OnClick" />
                        <Button
                            Content="조건 초기화"
                            Command="{Binding ClearSearchCommand}"
                            Style="{StaticResource MkSecondaryButtonStyle}"
                            HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="MapPane" Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="8">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                        <Button Content="+" Width="40" Style="{StaticResource MkSecondaryButtonStyle}" Command="{Binding ZoomInCommand}" />
                        <Button Content="-" Width="40" Style="{StaticResource MkSecondaryButtonStyle}" Command="{Binding ZoomOutCommand}" />
                        <Button Content="전체 보기" Style="{StaticResource MkSecondaryButtonStyle}" Command="{Binding FitAllCommand}" MinWidth="72" Padding="8,4" />
                        <Button Content="현재 선택" Style="{StaticResource MkSecondaryButtonStyle}" Command="{Binding FocusSelectedCommand}" MinWidth="72" Padding="8,4" />
                        <Button Content="갤러리" Style="{StaticResource MkSecondaryButtonStyle}" Command="{Binding OpenGalleryCommand}" MinWidth="64" Padding="8,4" />
                    </StackPanel>
                </ScrollViewer>
                <Border
                    Grid.Row="1"
                    CornerRadius="{StaticResource MkCardCornerRadius}"
                    BorderThickness="0"
                    Background="{ThemeResource MkBrushSurface}">
                    <WebView2 x:Name="MapWebView" />
                </Border>
            </Grid>
        </Grid>

        <!-- Selected place memory card + recent photos -->
        <Border
            x:Name="SelectedPlaceCard"
            Grid.Row="2"
            Style="{StaticResource MkCardStyle}"
            Visibility="Collapsed">
            <Grid ColumnDefinitions="220,*" ColumnSpacing="{StaticResource MkCardSpacing}">
                <!-- Large representative photo -->
                <Border Height="180" Style="{StaticResource MkThumbnailBorderStyle}">
                    <Grid>
                        <Border Background="{ThemeResource MkBrushSurfaceMuted}">
                            <TextBlock
                                Text="사진 없음"
                                Style="{StaticResource MkCaptionTextStyle}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <Image
                            x:Name="SelectedPlaceThumbImage"
                            Style="{StaticResource MkImageStyle}" />
                    </Grid>
                </Border>

                <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" RowSpacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock
                            Text="{Binding SelectedPlace.PlaceName, Mode=OneWay}"
                            Style="{StaticResource MkPlaceNameStyle}"
                            FontSize="22" />
                        <TextBlock
                            Text="{Binding SelectedPlace.DateRangeText, Mode=OneWay}"
                            Style="{StaticResource MkCaptionTextStyle}" />
                        <TextBlock Style="{StaticResource MkMetaTextStyle}">
                            <Run Text="사진 " />
                            <Run Text="{Binding SelectedPlace.PhotoCount, Mode=OneWay}" />
                            <Run Text="장" />
                        </TextBlock>
                    </StackPanel>

                    <Button
                        Grid.Row="1"
                        Content="사진 보기"
                        Style="{StaticResource MkPrimaryButtonStyle}"
                        HorizontalAlignment="Left"
                        MinWidth="120"
                        Click="OpenSelectedPhotos_OnClick" />

                    <!-- Recent 4 photos -->
                    <ItemsControl
                        x:Name="PreviewFourHost"
                        Grid.Row="2"
                        VerticalAlignment="Bottom">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Width="72"
                                    Height="72"
                                    Style="{StaticResource MkThumbnailBorderStyle}"
                                    Tapped="PreviewThumb_OnTapped"
                                    Tag="{Binding}">
                                    <Image Style="{StaticResource MkImageStyle}" Source="{Binding ThumbnailImage, Mode=OneWay}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>
        </Border>

        <ProgressRing
            Width="48"
            Height="48"
            IsActive="{Binding IsBusy, Mode=OneWay}"
            Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />
        </Grid>

        <!-- Search dropdown overlay: sibling of layout grid so map is never pushed -->
        <Border
            x:Name="SuggestionsPanel"
            Width="520"
            MaxHeight="200"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Style="{StaticResource MkSuggestionPanelStyle}"
            Margin="0"
            Visibility="{Binding IsSuggestionOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Spacing="4">
                <TextBlock Text="검색 결과" Style="{StaticResource MkSuggestionHeaderStyle}" />
                <ListView
                    ItemsSource="{Binding Suggestions, Mode=OneWay}"
                    IsItemClickEnabled="True"
                    ItemClick="Suggestion_OnItemClick"
                    MaxHeight="160"
                    SelectionMode="None"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayText}" Margin="8,4" Style="{StaticResource MkBodyTextStyle}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>
        <Border
            x:Name="RecentPanel"
            Width="520"
            MaxHeight="200"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Style="{StaticResource MkSuggestionPanelStyle}"
            Margin="0"
            Visibility="{Binding IsRecentOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Spacing="4">
                <TextBlock Text="최근 검색" Style="{StaticResource MkSuggestionHeaderStyle}" />
                <ListView
                    ItemsSource="{Binding RecentQueries, Mode=OneWay}"
                    IsItemClickEnabled="True"
                    ItemClick="Recent_OnItemClick"
                    MaxHeight="160"
                    SelectionMode="None"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Margin="4" Style="{StaticResource MkBodyTextStyle}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>
    </Grid>
</Page>
