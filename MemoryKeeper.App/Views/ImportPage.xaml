<Page

    x:Class="MemoryKeeper.App.Views.ImportPage"

    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

    xmlns:converters="using:MemoryKeeper.App.Converters"

    mc:Ignorable="d">



    <Page.Resources>

        <converters:BoolNegationConverter x:Key="BoolNegationConverter" />

    </Page.Resources>



    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="16">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="뒤로" Command="{Binding GoBackCommand}" Padding="10,4" />
            <TextBlock
                Text="사진등록"
                FontSize="28"
                FontWeight="SemiBold"
                VerticalAlignment="Center" />
        </StackPanel>


        <StackPanel Grid.Row="1" Spacing="4">

            <TextBlock Text="MemoryKeeper 저장소" FontWeight="SemiBold" />

            <TextBlock

                Text="{Binding MemoryKeeperStoragePath, Mode=OneWay}"

                TextWrapping="Wrap"

                Opacity="0.85"

                IsTextSelectionEnabled="True" />

        </StackPanel>



        <Grid
            Grid.Row="2"
            MaxWidth="{StaticResource MkInputMaxWidth}"
            HorizontalAlignment="Left"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="8">
            <TextBox
                Style="{StaticResource MkTextBoxStyle}"
                Header="등록할 폴더"
                Text="{Binding SourceFolderPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                IsReadOnly="True" />
            <Button
                Grid.Column="1"
                Content="폴더 선택"
                Style="{StaticResource MkButtonStyle}"
                VerticalAlignment="Bottom"
                Command="{Binding BrowseFolderCommand}"
                IsEnabled="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}" />
        </Grid>



        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">

            <Button

                Content="사진등록 시작"

                Style="{StaticResource AccentButtonStyle}"

                Command="{Binding ImportCommand}"

                IsEnabled="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}" />

            <Button

                Content="취소"

                Command="{Binding CancelImportCommand}"

                IsEnabled="{Binding IsBusy, Mode=OneWay}" />

        </StackPanel>



        <Grid Grid.Row="4" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">

            <ProgressBar
                Minimum="0"
                Maximum="1"
                Value="{Binding ProgressValue, Mode=OneWay}"
                Height="8" />


            <TextBlock
                Grid.Row="1"
                Text="{Binding CurrentStage, Mode=OneWay}"
                FontWeight="SemiBold"
                Opacity="0.85" />

            <TextBlock
                Grid.Row="2"
                Text="{Binding ProgressCountText, Mode=OneWay}"
                Opacity="0.75" />

            <TextBlock
                Grid.Row="3"
                Text="{Binding CurrentFileName, Mode=OneWay}"
                Opacity="0.75"
                TextWrapping="Wrap" />

            <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="20">
                <TextBlock Text="{Binding TotalCountText, Mode=OneWay}" />
                <TextBlock Text="{Binding ProcessedCountText, Mode=OneWay}" />
                <TextBlock Text="{Binding RegisteredCountText, Mode=OneWay}" />
                <TextBlock Text="{Binding DuplicateCountText, Mode=OneWay}" />
                <TextBlock Text="{Binding FailedCountText, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <TextBlock
            Grid.Row="5"
            Text="{Binding StatusMessage, Mode=OneWay}"
            TextWrapping="Wrap"
            VerticalAlignment="Top"
            Opacity="0.85" />
    </Grid>
</Page>


