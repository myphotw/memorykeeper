<Page
    x:Class="MemoryKeeper.App.Views.SetupWizardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:MemoryKeeper.App.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <ScrollViewer>
        <StackPanel MaxWidth="720" HorizontalAlignment="Center" Spacing="16" Padding="12">
            <TextBlock Text="Memory Keeper 시작하기" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="집 위치만 선택하면 바로 사용할 수 있습니다." Opacity="0.75" />
            <TextBlock Text="{Binding StatusMessage, Mode=OneWay}" TextWrapping="Wrap" />

            <StackPanel x:Name="Step1Panel" Spacing="12">
                <TextBlock Text="집 위치" FontSize="20" FontWeight="SemiBold" />
                <StackPanel
                    Spacing="10"
                    Visibility="{Binding HasSelectedHome, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                    <TextBox
                        Header="주소 또는 장소 검색"
                        Text="{Binding HomeAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="예: 서울특별시 구로구" />
                    <Border
                        Padding="8"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Visibility="{Binding HasHomeSuggestions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ListView
                            ItemsSource="{Binding HomeSuggestions, Mode=OneWay}"
                            IsItemClickEnabled="True"
                            ItemClick="HomeSuggestion_OnItemClick"
                            MaxHeight="240"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="2" Padding="4,6">
                                        <TextBlock Text="{Binding PrimaryText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SecondaryText}" Opacity="0.7" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </StackPanel>
                <StackPanel
                    Spacing="8"
                    Visibility="{Binding HasSelectedHome, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding HomeResolvedSummary, Mode=OneWay}" FontSize="17" TextWrapping="Wrap" />
                    <Button Content="변경" Command="{Binding ChangeHomeCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="Step2Panel" Spacing="12" Visibility="Collapsed">
                <TextBlock Text="설정 완료" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="사진첩, 방문지도, 여행기록과 NAS Gallery를 바로 이용할 수 있습니다." TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="이전" Command="{Binding BackCommand}" />
                <Button
                    x:Name="NextButton"
                    Content="다음"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{Binding NextCommand}" />
                <Button
                    x:Name="FinishButton"
                    Content="시작"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{Binding FinishCommand}"
                    Visibility="Collapsed" />
            </StackPanel>

            <ProgressRing IsActive="{Binding IsBusy, Mode=OneWay}" Width="32" Height="32" />
        </StackPanel>
    </ScrollViewer>
</Page>
