<Page
    x:Class="MemoryKeeper.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:MemoryKeeper.App.Converters"
    mc:Ignorable="d"
    Loaded="HomePage_OnLoaded"
    Unloaded="HomePage_OnUnloaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <SolidColorBrush x:Key="HomeAccentBrush" Color="#007AFF" />
        <SolidColorBrush x:Key="HomePageBgBrush" Color="#F5F5F7" />
        <SolidColorBrush x:Key="HomeCardBorderBrush" Color="#E5E5EA" />
        <SolidColorBrush x:Key="HomeMutedTextBrush" Color="#8E8E93" />
        <SolidColorBrush x:Key="HomeIconBlueBg" Color="#E8F1FF" />
        <SolidColorBrush x:Key="HomeIconGreenBg" Color="#E6F7ED" />
        <SolidColorBrush x:Key="HomeIconOrangeBg" Color="#FFF1E6" />
        <SolidColorBrush x:Key="HomeIconPurpleBg" Color="#F3E8FF" />
        <SolidColorBrush x:Key="HomeIconBlue" Color="#007AFF" />
        <SolidColorBrush x:Key="HomeIconGreen" Color="#34C759" />
        <SolidColorBrush x:Key="HomeIconOrange" Color="#FF9500" />
        <SolidColorBrush x:Key="HomeIconPurple" Color="#AF52DE" />

        <Style x:Key="HomeCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource HomeCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="HomeSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1C1C1E" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="HomeStatCardStyle" TargetType="Border" BasedOn="{StaticResource HomeCardStyle}">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="MinHeight" Value="92" />
        </Style>

        <Style x:Key="HomeSkeletonBlockStyle" TargetType="Border">
            <Setter Property="Background" Value="#E8E8ED" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Opacity" Value="0.65" />
        </Style>

        <Style x:Key="HomeLinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource HomeAccentBrush}" />
        </Style>

        <Style x:Key="HomeHeroNavButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="#F2FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource HomePageBgBrush}">
        <ScrollViewer
            x:Name="MainScroll"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            Padding="0">
            <Grid
                x:Name="MainContent"
                MaxWidth="1180"
                HorizontalAlignment="Stretch"
                Padding="28,24,28,36"
                RowSpacing="22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Hero -->
                <Border
                    x:Name="HeroCard"
                    Grid.Row="0"
                    Height="320"
                    CornerRadius="18"
                    Padding="24"
                    Background="#F2F2F7"
                    PointerEntered="Card_OnPointerEntered"
                    PointerExited="Card_OnPointerExited"
                    Tapped="HeroCard_OnTapped">
                    <Grid x:Name="HeroLayoutGrid" ColumnSpacing="24" RowSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="0" />
                        </Grid.RowDefinitions>

                        <Border
                            x:Name="HeroImageFrame"
                            Width="360"
                            Height="270"
                            CornerRadius="14"
                            Background="#E5E5EA"
                            VerticalAlignment="Center">
                            <Grid>
                                <Image x:Name="HeroImageBack" Stretch="Uniform" Opacity="0" />
                                <Image
                                    x:Name="HeroImageFront"
                                    Stretch="Uniform"
                                    Opacity="1"
                                    Source="{Binding CurrentHeroImage, Mode=OneWay}" />
                            </Grid>
                        </Border>

                        <Grid x:Name="HeroInfoGrid" Grid.Column="1" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="8" MaxWidth="520" VerticalAlignment="Center">
                                <TextBlock
                                    Text="Memory Keeper / 오늘의 추억"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="#8E8E93" />
                                <TextBlock
                                    Text="{Binding CurrentHeroTitle, Mode=OneWay}"
                                    FontSize="28"
                                    FontWeight="Bold"
                                    Foreground="#1C1C1E"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Text="{Binding CurrentHeroSubtitle, Mode=OneWay}"
                                    FontSize="14"
                                    Foreground="#636366" />
                                <TextBlock
                                    Text="{Binding CurrentHeroDescription, Mode=OneWay}"
                                    FontSize="13"
                                    Foreground="#8E8E93"
                                    TextWrapping="Wrap"
                                    MaxLines="2"
                                    Visibility="{Binding HasHero, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    Margin="0,8,0,0"
                                    Visibility="{Binding HasHeroCarousel, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Button Style="{StaticResource HomeHeroNavButtonStyle}" Click="HeroPrevious_OnClick">
                                        <FontIcon Glyph="&#xE76B;" FontSize="14" Foreground="#3A3A3C" />
                                    </Button>
                                    <Button Style="{StaticResource HomeHeroNavButtonStyle}" Click="HeroNext_OnClick">
                                        <FontIcon Glyph="&#xE76C;" FontSize="14" Foreground="#3A3A3C" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <Border
                                x:Name="HeroStatsPanel"
                                Grid.Column="1"
                                Width="210"
                                VerticalAlignment="Center"
                                CornerRadius="14"
                                Padding="16,14"
                                BorderThickness="1"
                                BorderBrush="#33FFFFFF">
                <Border.Background>
                    <AcrylicBrush
                        TintColor="#2C2C2E"
                        TintOpacity="0.55"
                        FallbackColor="#CC2C2C2E" />
                </Border.Background>
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE722;" FontSize="14" Foreground="White" Opacity="0.9" />
                                        <TextBlock Grid.Column="1" Text="전체 사진" Foreground="White" FontSize="13" Opacity="0.9" />
                                        <TextBlock Grid.Column="2" Text="{Binding Statistics.PhotoCount, Mode=OneWay}" Foreground="White" FontSize="13" FontWeight="SemiBold" />
                                    </Grid>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE707;" FontSize="14" Foreground="White" Opacity="0.9" />
                                        <TextBlock Grid.Column="1" Text="방문 장소" Foreground="White" FontSize="13" Opacity="0.9" />
                                        <TextBlock Grid.Column="2" Text="{Binding Statistics.PlaceCount, Mode=OneWay}" Foreground="White" FontSize="13" FontWeight="SemiBold" />
                                    </Grid>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE909;" FontSize="14" Foreground="White" Opacity="0.9" />
                                        <TextBlock Grid.Column="1" Text="방문 국가" Foreground="White" FontSize="13" Opacity="0.9" />
                                        <TextBlock Grid.Column="2" Text="{Binding Statistics.CountryCount, Mode=OneWay}" Foreground="White" FontSize="13" FontWeight="SemiBold" />
                                    </Grid>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE787;" FontSize="14" Foreground="White" Opacity="0.9" />
                                        <TextBlock Grid.Column="1" Text="최근 업데이트" Foreground="White" FontSize="13" Opacity="0.9" />
                                        <TextBlock Grid.Column="2" Text="{Binding LastUpdatedDisplay, Mode=OneWay}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Stats row -->
                <Grid
                    x:Name="StatsGrid"
                    Grid.Row="1"
                    ColumnSpacing="14"
                    RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        x:Name="StatPhotosCard"
                        Style="{StaticResource HomeStatCardStyle}"
                        Tapped="StatPhotos_OnTapped"
                        PointerEntered="Card_OnPointerEntered"
                        PointerExited="Card_OnPointerExited">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource HomeIconBlueBg}">
                                <FontIcon Glyph="&#xE91B;" FontSize="18" Foreground="{StaticResource HomeIconBlue}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PhotoCountDisplay, Mode=OneWay}" FontSize="22" FontWeight="Bold" Foreground="#1C1C1E" />
                                <TextBlock Text="모든 사진" FontSize="12" Foreground="{StaticResource HomeMutedTextBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border
                        x:Name="StatGpsCard"
                        Grid.Column="1"
                        Style="{StaticResource HomeStatCardStyle}"
                        Tapped="StatGps_OnTapped"
                        PointerEntered="Card_OnPointerEntered"
                        PointerExited="Card_OnPointerExited">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource HomeIconGreenBg}">
                                <FontIcon Glyph="&#xE1D2;" FontSize="18" Foreground="{StaticResource HomeIconGreen}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding GpsCountDisplay, Mode=OneWay}" FontSize="22" FontWeight="Bold" Foreground="#1C1C1E" />
                                <TextBlock Text="위치 정보가 있는 사진" FontSize="12" Foreground="{StaticResource HomeMutedTextBrush}" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border
                        x:Name="StatPlacesCard"
                        Grid.Column="2"
                        Style="{StaticResource HomeStatCardStyle}"
                        Tapped="StatPlaces_OnTapped"
                        PointerEntered="Card_OnPointerEntered"
                        PointerExited="Card_OnPointerExited">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource HomeIconOrangeBg}">
                                <FontIcon Glyph="&#xE707;" FontSize="18" Foreground="{StaticResource HomeIconOrange}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PlaceCountDisplay, Mode=OneWay}" FontSize="22" FontWeight="Bold" Foreground="#1C1C1E" />
                                <TextBlock Text="다녀온 장소" FontSize="12" Foreground="{StaticResource HomeMutedTextBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border
                        x:Name="StatCountriesCard"
                        Grid.Column="3"
                        Style="{StaticResource HomeStatCardStyle}"
                        Tapped="StatCountries_OnTapped"
                        PointerEntered="Card_OnPointerEntered"
                        PointerExited="Card_OnPointerExited">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource HomeIconPurpleBg}">
                                <FontIcon Glyph="&#xE128;" FontSize="18" Foreground="{StaticResource HomeIconPurple}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CountryCountDisplay, Mode=OneWay}" FontSize="22" FontWeight="Bold" Foreground="#1C1C1E" />
                                <TextBlock Text="{Binding CountrySummaryText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource HomeMutedTextBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Recent visits -->
                <Border
                    x:Name="RecentVisitsCard"
                    Grid.Row="2"
                    Style="{StaticResource HomeCardStyle}"
                    PointerEntered="Card_OnPointerEntered"
                    PointerExited="Card_OnPointerExited">
                    <Grid RowDefinitions="Auto,*">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                            <TextBlock Text="최근 방문 장소" Style="{StaticResource HomeSectionTitleStyle}" Margin="0" />
                            <Button
                                Grid.Column="1"
                                Content="방문지도 보기 ›"
                                Style="{StaticResource HomeLinkButtonStyle}"
                                VerticalAlignment="Center"
                                Command="{Binding QuickVisitRecordCommand}" />
                        </Grid>

                        <ItemsControl
                            Grid.Row="1"
                            ItemsSource="{Binding RecentVisits, Mode=OneWay}"
                            Visibility="{Binding HasRecentVisits, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Width="260"
                                        Background="White"
                                        BorderBrush="#E5E5EA"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Margin="0,0,12,0"
                                        Tapped="RecentVisitCard_OnTapped"
                                        Tag="{Binding}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="172" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Border CornerRadius="14,14,0,0" Background="#F2F2F7">
                                                <Image Source="{Binding ThumbnailImage, Mode=OneWay}" Stretch="Uniform" />
                                            </Border>
                                            <Grid Grid.Row="1" Padding="14,12" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="4">
                                                    <TextBlock
                                                        Text="{Binding TitleLine}"
                                                        FontSize="15"
                                                        FontWeight="SemiBold"
                                                        TextTrimming="CharacterEllipsis"
                                                        Foreground="#1C1C1E" />
                                                    <TextBlock
                                                        Text="{Binding LastVisitText}"
                                                        FontSize="12"
                                                        Foreground="#8E8E93" />
                                                    <TextBlock
                                                        Text="{Binding PhotoCountText}"
                                                        FontSize="12"
                                                        Foreground="#8E8E93" />
                                                </StackPanel>
                                                <FontIcon
                                                    Grid.Column="1"
                                                    Glyph="&#xE76C;"
                                                    FontSize="12"
                                                    Foreground="#C7C7CC"
                                                    VerticalAlignment="Center" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock
                            Grid.Row="1"
                            Text="아직 방문 기록이 없어요."
                            FontSize="13"
                            Foreground="{StaticResource HomeMutedTextBrush}"
                            Visibility="{Binding HasRecentVisits, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                    </Grid>
                </Border>

                <!-- Photos + charts -->
                <Grid
                    x:Name="BottomSplitGrid"
                    Grid.Row="3"
                    ColumnSpacing="16"
                    RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        x:Name="RecentPhotosCard"
                        Style="{StaticResource HomeCardStyle}"
                        MinHeight="280"
                        PointerEntered="Card_OnPointerEntered"
                        PointerExited="Card_OnPointerExited">
                        <Grid RowDefinitions="Auto,*">
                            <TextBlock Text="최근 등록 사진" Style="{StaticResource HomeSectionTitleStyle}" />
                            <ItemsControl
                                Grid.Row="1"
                                ItemsSource="{Binding RecentImports, Mode=OneWay}"
                                Visibility="{Binding HasRecentImports, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="14" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="118" Spacing="8" Tapped="RecentImportThumb_OnTapped" Tag="{Binding}">
                                            <Border
                                                Height="168"
                                                CornerRadius="12"
                                                Background="#F2F2F7">
                                                <Image Source="{Binding ThumbnailImage, Mode=OneWay}" Stretch="UniformToFill" />
                                            </Border>
                                            <TextBlock
                                                Text="{Binding CaptionLine}"
                                                FontSize="11"
                                                Foreground="#8E8E93"
                                                TextWrapping="Wrap"
                                                MaxLines="2"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock
                                Grid.Row="1"
                                Text="최근 등록된 사진이 없어요."
                                FontSize="13"
                                Foreground="{StaticResource HomeMutedTextBrush}"
                                Visibility="{Binding HasRecentImports, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                        </Grid>
                    </Border>

                    <Border
                        x:Name="SummaryCard"
                        Grid.Column="1"
                        Style="{StaticResource HomeCardStyle}"
                        MinHeight="280"
                        PointerEntered="Card_OnPointerEntered"
                        PointerExited="Card_OnPointerExited">
                        <Grid RowDefinitions="Auto,*">
                            <TextBlock Text="기록 요약" Style="{StaticResource HomeSectionTitleStyle}" />
                            <Grid Grid.Row="1" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="10">
                                    <TextBlock Text="연도별 사진 수" FontSize="12" Foreground="{StaticResource HomeMutedTextBrush}" />
                                    <Border
                                        Height="168"
                                        Background="#FAFAFA"
                                        CornerRadius="12"
                                        Padding="12,10"
                                        Visibility="{Binding HasYearChart, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ItemsControl ItemsSource="{Binding YearBars, Mode=OneWay}" VerticalAlignment="Bottom">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="18" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Width="42" Spacing="6" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                        <TextBlock
                                                            Text="{Binding CountText}"
                                                            FontSize="11"
                                                            Foreground="#8E8E93"
                                                            HorizontalAlignment="Center" />
                                                        <Border
                                                            Width="28"
                                                            Height="{Binding BarHeight}"
                                                            CornerRadius="6,6,0,0"
                                                            Background="{StaticResource HomeAccentBrush}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Bottom" />
                                                        <TextBlock
                                                            Text="{Binding Year}"
                                                            FontSize="11"
                                                            Foreground="#1C1C1E"
                                                            HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                    <TextBlock
                                        Text="연도별 데이터가 없어요."
                                        FontSize="12"
                                        Foreground="{StaticResource HomeMutedTextBrush}"
                                        Visibility="{Binding HasYearChart, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="10">
                                    <TextBlock Text="국가별 사진 수" FontSize="12" Foreground="{StaticResource HomeMutedTextBrush}" />
                                    <Border
                                        Height="168"
                                        Background="#FAFAFA"
                                        CornerRadius="12"
                                        Padding="8"
                                        Visibility="{Binding HasCountryChart, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid>
                                            <Canvas
                                                x:Name="CountryDonutCanvas"
                                                Width="112"
                                                Height="112"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Top"
                                                Margin="0,4,0,0" />
                                            <ItemsControl
                                                ItemsSource="{Binding CountrySlices, Mode=OneWay}"
                                                VerticalAlignment="Bottom"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,4">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="12" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding LegendText}" FontSize="11" Foreground="#6E6E73" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                    <TextBlock
                                        Text="국가별 데이터가 없어요."
                                        FontSize="12"
                                        Foreground="{StaticResource HomeMutedTextBrush}"
                                        Visibility="{Binding HasCountryChart, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Quick actions -->
                <Border
                    x:Name="QuickActionsCard"
                    Grid.Row="4"
                    Style="{StaticResource HomeCardStyle}"
                    PointerEntered="Card_OnPointerEntered"
                    PointerExited="Card_OnPointerExited">
                    <StackPanel Spacing="14">
                        <TextBlock Text="빠른 작업" Style="{StaticResource HomeSectionTitleStyle}" Margin="0" />
                        <Grid x:Name="QuickActionsPanel" ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border
                                x:Name="QuickImportCard"
                                Background="#FAFAFA"
                                BorderBrush="#E5E5EA"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14,12"
                                Tapped="QuickImport_OnTapped">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource HomeIconBlueBg}">
                                        <FontIcon Glyph="&#xE898;" FontSize="16" Foreground="{StaticResource HomeIconBlue}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="사진 가져오기" FontSize="14" FontWeight="SemiBold" Foreground="#1C1C1E" />
                                        <TextBlock Text="새 사진 추가" FontSize="12" Foreground="{StaticResource HomeMutedTextBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border
                                x:Name="QuickOrganizeCard"
                                Grid.Column="1"
                                Background="#FAFAFA"
                                BorderBrush="#E5E5EA"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14,12"
                                Tapped="QuickOrganize_OnTapped">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource HomeIconOrangeBg}">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{StaticResource HomeIconOrange}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="사진 정리" FontSize="14" FontWeight="SemiBold" Foreground="#1C1C1E" />
                                        <TextBlock Text="정리 및 분류" FontSize="12" Foreground="{StaticResource HomeMutedTextBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border
                                x:Name="QuickMapCard"
                                Grid.Column="2"
                                Background="#FAFAFA"
                                BorderBrush="#E5E5EA"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14,12"
                                Tapped="QuickMap_OnTapped">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource HomeIconGreenBg}">
                                        <FontIcon Glyph="&#xE1C4;" FontSize="16" Foreground="{StaticResource HomeIconGreen}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="방문지도" FontSize="14" FontWeight="SemiBold" Foreground="#1C1C1E" />
                                        <TextBlock Text="장소별 확인" FontSize="12" Foreground="{StaticResource HomeMutedTextBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border
                                x:Name="QuickTravelCard"
                                Grid.Column="3"
                                Background="#FAFAFA"
                                BorderBrush="#E5E5EA"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14,12"
                                Tapped="QuickTravel_OnTapped">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource HomeIconPurpleBg}">
                                        <FontIcon Glyph="&#xE82D;" FontSize="16" Foreground="{StaticResource HomeIconPurple}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="여행기록" FontSize="14" FontWeight="SemiBold" Foreground="#1C1C1E" />
                                        <TextBlock Text="여행 추억 보기" FontSize="12" Foreground="{StaticResource HomeMutedTextBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Footer -->
                <StackPanel Grid.Row="5" HorizontalAlignment="Center" Spacing="4" Margin="0,8,0,0">
                    <TextBlock Text="Memory Keeper" FontSize="13" FontWeight="SemiBold" Foreground="#AEAEB2" HorizontalAlignment="Center" />
                    <TextBlock Text="소중한 추억을 안전하게 보관하세요." FontSize="12" Foreground="#C7C7CC" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Skeleton -->
        <Grid
            x:Name="SkeletonRoot"
            MaxWidth="1180"
            HorizontalAlignment="Stretch"
            Padding="28,24"
            Visibility="Collapsed"
            RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource HomeSkeletonBlockStyle}" Height="300" />
            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource HomeSkeletonBlockStyle}" Height="92" />
                <Border Grid.Column="1" Style="{StaticResource HomeSkeletonBlockStyle}" Height="92" />
                <Border Grid.Column="2" Style="{StaticResource HomeSkeletonBlockStyle}" Height="92" />
                <Border Grid.Column="3" Style="{StaticResource HomeSkeletonBlockStyle}" Height="92" />
            </Grid>
            <Border Grid.Row="2" Style="{StaticResource HomeSkeletonBlockStyle}" Height="200" />
        </Grid>

        <!-- Empty -->
        <Grid
            x:Name="EmptyState"
            MaxWidth="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Padding="32"
            Visibility="Collapsed">
            <Border Style="{StaticResource MkEmptyStateCardStyle}">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <TextBlock Text="첫 추억을 가져와보세요." Style="{StaticResource MkEmptyStateTitleStyle}" />
                    <TextBlock
                        Text="사진을 가져오면 Home에서 추억을 다시 만날 수 있어요."
                        Style="{StaticResource MkEmptyStateMessageStyle}" />
                    <Button
                        Content="사진 가져오기"
                        Style="{StaticResource MkPrimaryButtonStyle}"
                        MinWidth="200"
                        HorizontalAlignment="Center"
                        Command="{Binding QuickImportCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
