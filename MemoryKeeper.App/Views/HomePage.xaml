<Page
    x:Class="MemoryKeeper.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:MemoryKeeper.App.Converters"
    mc:Ignorable="d"
    Loaded="HomePage_OnLoaded"
    Unloaded="HomePage_OnUnloaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="HomeCardStyle" TargetType="Border" BasedOn="{StaticResource MkCardStyle}">
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="HomeSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource MkCardTitleStyle}">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="HomeQuickButtonStyle" TargetType="Button" BasedOn="{StaticResource MkSecondaryButtonStyle}">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{ThemeResource MkBrushSurfaceMuted}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="HomeQuickPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource MkPrimaryButtonStyle}">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource MkBrushBackground}">
        <!-- Main content: fit ~1080 without scroll -->
        <Grid
            x:Name="MainContent"
            MaxWidth="1180"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch"
            Padding="28,20,28,24"
            RowSpacing="20"
            Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MaxHeight="340" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="200" />
            </Grid.RowDefinitions>

            <!-- ① Hero -->
            <Border
                x:Name="HeroCard"
                Grid.Row="0"
                Style="{StaticResource HomeCardStyle}"
                Padding="0"
                Height="300"
                Visibility="{Binding HasHero, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                PointerEntered="Card_OnPointerEntered"
                PointerExited="Card_OnPointerExited"
                Tapped="HeroCard_OnTapped">
                <Grid>
                    <Image x:Name="HeroImageBack" Stretch="UniformToFill" Opacity="0" />
                    <Image
                        x:Name="HeroImageFront"
                        Stretch="UniformToFill"
                        Opacity="1"
                        Source="{Binding CurrentHeroImage, Mode=OneWay}" />
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#10000000" Offset="0" />
                                <GradientStop Color="#48000000" Offset="0.55" />
                                <GradientStop Color="#A82C2A26" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <Grid Padding="28,24" VerticalAlignment="Bottom">
                        <StackPanel Spacing="6" MaxWidth="560">
                            <TextBlock
                                Text="{Binding CurrentHeroTitle, Mode=OneWay}"
                                FontSize="30"
                                FontWeight="SemiBold"
                                Foreground="White"
                                TextWrapping="NoWrap"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Text="{Binding CurrentHeroSubtitle, Mode=OneWay}"
                                FontSize="14"
                                Foreground="White"
                                Opacity="0.9" />
                            <TextBlock
                                Text="{Binding CurrentHeroDescription, Mode=OneWay}"
                                FontSize="13"
                                Foreground="White"
                                Opacity="0.82"
                                TextWrapping="NoWrap"
                                TextTrimming="CharacterEllipsis"
                                Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button
                                    Content="다시 보기"
                                    Style="{StaticResource MkPrimaryButtonStyle}"
                                    MinHeight="40"
                                    Padding="18,8"
                                    Click="HeroReplay_OnClick" />
                                <Button
                                    Content="‹"
                                    Width="40"
                                    Style="{StaticResource MkSecondaryButtonStyle}"
                                    Click="HeroPrevious_OnClick"
                                    Visibility="{Binding HasHeroCarousel, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Button
                                    Content="›"
                                    Width="40"
                                    Style="{StaticResource MkSecondaryButtonStyle}"
                                    Click="HeroNext_OnClick"
                                    Visibility="{Binding HasHeroCarousel, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <ItemsControl
                        ItemsSource="{Binding HeroIndicators, Mode=OneWay}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,12"
                        Visibility="{Binding HasHeroCarousel, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Ellipse
                                    Width="6"
                                    Height="6"
                                    Fill="White"
                                    Opacity="{Binding DotOpacity, Mode=OneWay}"
                                    Tapped="HeroIndicator_OnTapped"
                                    Tag="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Quiet line when no hero but library exists -->
            <TextBlock
                x:Name="NoHeroHint"
                Grid.Row="0"
                Text="{Binding StatusMessage, Mode=OneWay}"
                Style="{StaticResource MkCaptionTextStyle}"
                VerticalAlignment="Center"
                Visibility="Collapsed" />

            <!-- ② Mid: 최근 가져오기 | 최근 등록 사진 -->
            <Grid
                x:Name="MidGrid"
                Grid.Row="1"
                ColumnSpacing="20"
                RowSpacing="12"
                Height="168">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.35*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    x:Name="ImportSummaryCard"
                    Style="{StaticResource HomeCardStyle}"
                    PointerEntered="Card_OnPointerEntered"
                    PointerExited="Card_OnPointerExited">
                    <StackPanel Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="최근 가져오기" Style="{StaticResource HomeSectionTitleStyle}" Margin="0,0,0,4" />
                        <TextBlock
                            x:Name="ImportDateText"
                            Style="{StaticResource MkBodyTextStyle}"
                            Foreground="{ThemeResource MkBrushTextSecondary}" />
                        <TextBlock
                            x:Name="ImportCountText"
                            Style="{StaticResource MkBodyTextStyle}"
                            Foreground="{ThemeResource MkBrushTextSecondary}" />
                        <TextBlock
                            x:Name="ImportStatusText"
                            Style="{StaticResource MkCaptionTextStyle}"
                            Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border
                    x:Name="RecentPhotosCard"
                    Grid.Column="1"
                    Style="{StaticResource HomeCardStyle}"
                    Padding="16,16,12,12"
                    PointerEntered="Card_OnPointerEntered"
                    PointerExited="Card_OnPointerExited">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Text="최근 등록 사진" Style="{StaticResource HomeSectionTitleStyle}" Margin="0,0,0,8" />
                        <ScrollViewer
                            Grid.Row="1"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Disabled"
                            HorizontalScrollMode="Enabled"
                            VerticalScrollMode="Disabled">
                            <ItemsControl ItemsSource="{Binding RecentImports, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="10" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Width="88"
                                            Height="88"
                                            CornerRadius="10"
                                            Background="{ThemeResource MkBrushSurfaceMuted}"
                                            Tapped="RecentImportThumb_OnTapped"
                                            Tag="{Binding}">
                                            <Image
                                                Source="{Binding ThumbnailImage, Mode=OneWay}"
                                                Stretch="UniformToFill" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ③ Bottom: 최근 방문 | 빠른 작업 -->
            <Grid
                x:Name="BottomGrid"
                Grid.Row="2"
                ColumnSpacing="20"
                RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    x:Name="RecentVisitsCard"
                    Style="{StaticResource HomeCardStyle}"
                    PointerEntered="Card_OnPointerEntered"
                    PointerExited="Card_OnPointerExited">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Text="최근 방문 장소" Style="{StaticResource HomeSectionTitleStyle}" />
                        <ListView
                            Grid.Row="1"
                            ItemsSource="{Binding RecentVisits, Mode=OneWay}"
                            SelectionMode="None"
                            IsItemClickEnabled="True"
                            ItemClick="RecentVisitList_OnItemClick"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="56,*" ColumnSpacing="12">
                                        <Border
                                            Width="56"
                                            Height="56"
                                            CornerRadius="10"
                                            Background="{ThemeResource MkBrushSurfaceMuted}">
                                            <Image
                                                Source="{Binding ThumbnailImage, Mode=OneWay}"
                                                Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{Binding PlaceName}"
                                                FontSize="15"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource MkBrushTextPrimary}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Text="{Binding LastVisitText}"
                                                FontSize="12"
                                                Foreground="{ThemeResource MkBrushTextSecondary}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <Border
                    x:Name="QuickActionsCard"
                    Grid.Column="1"
                    Style="{StaticResource HomeCardStyle}"
                    PointerEntered="Card_OnPointerEntered"
                    PointerExited="Card_OnPointerExited">
                    <StackPanel>
                        <TextBlock Text="빠른 작업" Style="{StaticResource HomeSectionTitleStyle}" />
                        <Button
                            Content="사진 가져오기"
                            Style="{StaticResource HomeQuickPrimaryButtonStyle}"
                            Command="{Binding QuickImportCommand}" />
                        <Button
                            Content="사진 정리"
                            Style="{StaticResource HomeQuickButtonStyle}"
                            Command="{Binding OpenPendingCommand}" />
                        <Button
                            Content="여행기록"
                            Style="{StaticResource HomeQuickButtonStyle}"
                            Command="{Binding OpenStatisticsCommand}" />
                        <Button
                            Content="방문지도"
                            Style="{StaticResource HomeQuickButtonStyle}"
                            Margin="0"
                            Command="{Binding QuickVisitRecordCommand}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Empty state -->
        <Grid
            x:Name="EmptyState"
            MaxWidth="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Padding="32"
            Visibility="Collapsed">
            <Border Style="{StaticResource MkEmptyStateCardStyle}">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <TextBlock
                        Text="첫 추억을 가져와보세요."
                        Style="{StaticResource MkEmptyStateTitleStyle}" />
                    <TextBlock
                        Text="사진을 가져오면 Home에서 추억을 다시 만날 수 있어요."
                        Style="{StaticResource MkEmptyStateMessageStyle}" />
                    <Button
                        Content="사진 가져오기"
                        Style="{StaticResource MkPrimaryButtonStyle}"
                        MinWidth="200"
                        HorizontalAlignment="Center"
                        Command="{Binding QuickImportCommand}" />
                </StackPanel>
            </Border>
        </Grid>

        <ProgressRing
            Width="48"
            Height="48"
            IsActive="{Binding IsBusy, Mode=OneWay}"
            Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />
    </Grid>
</Page>
