<Page
    x:Class="MemoryKeeper.App.Views.GalleryPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:MemoryKeeper.App.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="GalleryFilterButtonStyle" TargetType="Button" BasedOn="{StaticResource MkTextButtonStyle}">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Opacity" Value="0.78" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style x:Key="GalleryTreeNodeStyle" TargetType="Button" BasedOn="{StaticResource MkTextButtonStyle}">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Opacity" Value="0.85" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="GalleryPhotoCardStyle" TargetType="Border">
            <Setter Property="Width" Value="188" />
            <Setter Property="Height" Value="224" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource MkImageCornerRadius}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="{ThemeResource MkBrushPrimary}" />
        </Style>
    </Page.Resources>

    <Grid
        Style="{StaticResource MkWidePageContainerStyle}"
        Background="{ThemeResource MkBrushBackground}"
        ColumnSpacing="{StaticResource MkPageColumnGap}"
        MinWidth="640"
        MinHeight="360">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.22*" />
            <ColumnDefinition Width="0.78*" />
            <ColumnDefinition x:Name="DetailColumn" Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Quiet filter column (not the visual hero) -->
        <Grid
            RowDefinitions="Auto,Auto,Auto,*"
            RowSpacing="12"
            Opacity="0.88"
            Padding="4,8,8,8">
                <TextBlock
                    Text="찾아보기"
                    Style="{StaticResource MkCaptionTextStyle}"
                    Opacity="0.65"
                    Margin="0,0,0,4" />

                <TextBox
                    Grid.Row="1"
                    Style="{StaticResource MkSearchBoxStyle}"
                    PlaceholderText="장소 · 국가 · 지역 · 파일명"
                    IsEnabled="{Binding CanInteract}"
                    Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                    <Button
                        Content="연도"
                        Command="{Binding SelectYearBrowseCommand}"
                        IsEnabled="{Binding CanInteract}"
                        Style="{StaticResource MkPrimaryButtonStyle}"
                        Padding="12,6"
                        MinHeight="32"
                        FontSize="13"
                        Visibility="{Binding IsYearBrowseMode, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Button
                        Content="연도"
                        Command="{Binding SelectYearBrowseCommand}"
                        IsEnabled="{Binding CanInteract}"
                        Style="{StaticResource GalleryFilterButtonStyle}"
                        Visibility="{Binding IsYearBrowseMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                    <Button
                        Content="장소"
                        Command="{Binding SelectPlaceBrowseCommand}"
                        IsEnabled="{Binding CanInteract}"
                        Style="{StaticResource MkPrimaryButtonStyle}"
                        Padding="12,6"
                        MinHeight="32"
                        FontSize="13"
                        Visibility="{Binding IsPlaceBrowseMode, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Button
                        Content="장소"
                        Command="{Binding SelectPlaceBrowseCommand}"
                        IsEnabled="{Binding CanInteract}"
                        Style="{StaticResource GalleryFilterButtonStyle}"
                        Visibility="{Binding IsPlaceBrowseMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                </StackPanel>

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding VisibleTreeNodes, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Border
                                        Height="1"
                                        Margin="4,8"
                                        Background="{ThemeResource MkBrushDivider}"
                                        Opacity="0.5"
                                        Visibility="{Binding IsSeparator, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <Grid
                                        Margin="{Binding IndentMargin, Mode=OneWay}"
                                        ColumnDefinitions="Auto,*"
                                        ColumnSpacing="2"
                                        Visibility="{Binding IsSeparator, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                        <Button
                                            Content="{Binding ExpandGlyph, Mode=OneWay}"
                                            Padding="4,2"
                                            MinWidth="24"
                                            Style="{StaticResource GalleryTreeNodeStyle}"
                                            Click="Expand_OnClick"
                                            Tag="{Binding}"
                                            Visibility="{Binding CanExpand, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <Button
                                            Grid.Column="1"
                                            Style="{StaticResource GalleryTreeNodeStyle}"
                                            Content="{Binding DisplayLabel, Mode=OneWay}"
                                            Click="Node_OnClick"
                                            Tag="{Binding}"
                                            Foreground="{ThemeResource MkBrushPrimary}"
                                            FontWeight="SemiBold"
                                            Opacity="1"
                                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <Button
                                            Grid.Column="1"
                                            Style="{StaticResource GalleryTreeNodeStyle}"
                                            Content="{Binding DisplayLabel, Mode=OneWay}"
                                            Click="Node_OnClick"
                                            Tag="{Binding}"
                                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
        </Grid>

        <!-- Photo-first main column -->
        <Grid
            Grid.Column="1"
            RowDefinitions="Auto,*"
            RowSpacing="{StaticResource MkSectionSpacing}"
            MinWidth="240">

            <!-- Section header -->
            <Grid>
            <StackPanel Spacing="8">
                <Button
                    x:Name="BackNavigationButton"
                    Command="{Binding GoBackCommand}"
                    Style="{StaticResource MkBackNavigationButtonStyle}"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon
                            FontFamily="{StaticResource MkIconFontFamily}"
                            FontSize="14"
                            Glyph="&#xE72B;" />
                        <TextBlock
                            x:Name="BackNavigationLabel"
                            MaxWidth="280"
                            Text="뒤로"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </StackPanel>
                </Button>
                    <TextBlock
                        Text="사진첩"
                        Style="{StaticResource MkPageTitleStyle}"
                        Margin="0"
                        VerticalAlignment="Center" />
                <TextBlock
                    Text="{Binding BreadcrumbText, Mode=OneWay}"
                    Style="{StaticResource MkSectionTitleStyle}"
                    FontSize="18"
                    Margin="0" />
                <TextBlock
                    Text="{Binding StatusMessage, Mode=OneWay}"
                    Style="{StaticResource MkCaptionTextStyle}"
                    Opacity="0.75" />
                <InfoBar
                    IsOpen="{Binding IsMutationInfoOpen, Mode=TwoWay}"
                    Severity="{Binding MutationInfoSeverity}"
                    Message="{Binding MutationInfoMessage}"
                    IsClosable="True" />
            </StackPanel>

                <Button
                    Content="편집"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Style="{StaticResource MkSecondaryButtonStyle}"
                    IsEnabled="{Binding CanInteract}"
                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                    Click="EnterEditMode_OnClick" />

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button
                        Content="편집 종료"
                        Style="{StaticResource MkSecondaryButtonStyle}"
                        IsEnabled="{Binding CanInteract}"
                        Click="ExitEditMode_OnClick" />
                    <Button
                        x:Name="SelectAllButton"
                        Content="전체 선택"
                        Style="{StaticResource MkSecondaryButtonStyle}"
                        IsEnabled="{Binding CanInteract}"
                        Click="SelectAll_OnClick" />
                    <Button
                        Content="장소 변경"
                        Style="{StaticResource MkPrimaryButtonStyle}"
                        IsEnabled="{Binding CanChangePlace}"
                        Click="ChangePlace_OnClick" />
                    <TextBlock
                        Text="{Binding SelectedCountText}"
                        VerticalAlignment="Center"
                        Style="{StaticResource MkBodyTextStyle}" />
                </StackPanel>
            </Grid>

            <!-- Photo grid -->
            <Grid Grid.Row="1">
                <GridView
                    x:Name="PhotoGrid"
                    ItemsSource="{Binding Items, Mode=OneWay}"
                    IsItemClickEnabled="True"
                    ItemClick="Gallery_OnItemClick"
                    SelectionChanged="PhotoGrid_OnSelectionChanged"
                    SelectionMode="None"
                    Visibility="Visible">
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Margin" Value="4" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            <Setter Property="UseSystemFocusVisuals" Value="True" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GridViewItem">
                                        <Grid Background="Transparent">
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup x:Name="CommonStates">
                                                    <VisualState x:Name="Normal" />
                                                    <VisualState x:Name="PointerOver" />
                                                    <VisualState x:Name="Pressed" />
                                                    <VisualState x:Name="Selected">
                                                        <VisualState.Setters>
                                                            <Setter Target="EditSelectionVisual.Visibility" Value="Visible" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                    <VisualState x:Name="PointerOverSelected">
                                                        <VisualState.Setters>
                                                            <Setter Target="EditSelectionVisual.Visibility" Value="Visible" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                    <VisualState x:Name="PressedSelected">
                                                        <VisualState.Setters>
                                                            <Setter Target="EditSelectionVisual.Visibility" Value="Visible" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                    <VisualState x:Name="Disabled">
                                                        <VisualState.Setters>
                                                            <Setter Target="ContentPresenter.Opacity" Value="0.45" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>

                                            <ContentPresenter
                                                x:Name="ContentPresenter"
                                                Content="{TemplateBinding Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                                ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                ContentTransitions="{TemplateBinding ContentTransitions}"
                                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                Padding="{TemplateBinding Padding}" />

                                            <Grid
                                                x:Name="EditSelectionVisual"
                                                Margin="10"
                                                Visibility="Collapsed"
                                                IsHitTestVisible="False">
                                                <Border
                                                    Background="{ThemeResource MkBrushPrimary}"
                                                    CornerRadius="{StaticResource MkImageCornerRadius}"
                                                    Opacity="0.12" />
                                                <Border
                                                    BorderBrush="{ThemeResource MkBrushPrimary}"
                                                    BorderThickness="3"
                                                    CornerRadius="{StaticResource MkImageCornerRadius}" />
                                                <Border
                                                    Width="28"
                                                    Height="28"
                                                    Margin="0,8,8,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Background="{ThemeResource MkBrushPrimary}"
                                                    CornerRadius="14">
                                                    <FontIcon
                                                        Glyph="&#xE73E;"
                                                        FontSize="14"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Foreground="{ThemeResource MkBrushTextOnPrimary}" />
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Style="{StaticResource GalleryPhotoCardStyle}"
                                Tag="{Binding}"
                                PointerEntered="PhotoCard_OnPointerEntered"
                                PointerExited="PhotoCard_OnPointerExited"
                                DoubleTapped="PhotoCard_OnDoubleTapped"
                                Loaded="PhotoCard_OnLoaded">
                                <Border.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem
                                            Text="상세"
                                            Tag="{Binding}"
                                            Click="PhotoDetail_OnClick" />
                                    </MenuFlyout>
                                </Border.ContextFlyout>
                                <Grid>
                                    <Border Style="{StaticResource MkThumbnailBorderStyle}">
                                        <Grid>
                                            <ProgressRing
                                                Width="24"
                                                Height="24"
                                                IsActive="{Binding IsThumbnailLoading, Mode=OneWay}"
                                                Visibility="{Binding IsThumbnailLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <Image
                                                Style="{StaticResource MkImageStyle}"
                                                Source="{Binding ThumbnailImage, Mode=OneWay}"
                                                Stretch="Uniform" />
                                            <TextBlock
                                                Text="★"
                                                FontSize="14"
                                                Foreground="{ThemeResource MkBrushAccentGold}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="0,8,8,0"
                                                Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </Grid>
                                    </Border>
                                    <!-- Soft primary wash when selected -->
                                    <Border
                                        CornerRadius="{StaticResource MkImageCornerRadius}"
                                        Background="{ThemeResource MkBrushPrimary}"
                                        IsHitTestVisible="False"
                                        Opacity="0.14"
                                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <Border
                    x:Name="GalleryEmptyState"
                    Style="{StaticResource MkEmptyStateCardStyle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="400"
                    Visibility="Collapsed">
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <TextBlock
                            Text="아직 사진이 없습니다."
                            Style="{StaticResource MkEmptyStateTitleStyle}" />
                        <TextBlock
                            Text="사진을 가져오면 추억이 사진첩에 쌓입니다."
                            Style="{StaticResource MkEmptyStateMessageStyle}" />
                        <Button
                            Content="사진 가져오기"
                            Style="{StaticResource MkPrimaryButtonStyle}"
                            MinWidth="180"
                            HorizontalAlignment="Center"
                            Click="ImportPhotos_OnClick" />
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>

        <!-- Gallery-local reusable photo detail. Auto column is zero while collapsed. -->
        <Border
            x:Name="DetailPanel"
            Grid.Column="2"
            Width="420"
            MinWidth="380"
            MaxWidth="440"
            HorizontalAlignment="Right"
            Margin="8,0,0,0"
            Padding="16"
            Background="{ThemeResource MkBrushSurface}"
            BorderBrush="{ThemeResource MkBrushBorder}"
            BorderThickness="1,0,0,0"
            CornerRadius="16,0,0,16"
            Visibility="Collapsed">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DetailPanelTransform" X="440" />
            </Border.RenderTransform>
            <Border.Transitions>
                <TransitionCollection>
                    <PaneThemeTransition Edge="Right" />
                </TransitionCollection>
            </Border.Transitions>
            <ContentControl
                x:Name="PhotoDetailHost"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch" />
        </Border>

        <Grid
            Grid.ColumnSpan="3"
            Canvas.ZIndex="100"
            Visibility="{Binding IsMutating, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border
                Background="{ThemeResource MkBrushBackground}"
                Opacity="0.88" />
            <Border
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MinWidth="400"
                MaxWidth="560"
                Padding="40,32"
                CornerRadius="16"
                Background="{ThemeResource MkBrushSurface}"
                BorderBrush="{ThemeResource MkBrushBorder}"
                BorderThickness="1">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <ProgressRing Width="64" Height="64" IsActive="True" />
                    <TextBlock
                        Text="{Binding MutationStatus}"
                        FontSize="24"
                        FontWeight="SemiBold"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="{Binding MutationHint}"
                        FontSize="15"
                        Opacity="0.72"
                        TextAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
