<UserControl
    x:Class="MemoryKeeper.App.Views.PlaceManagementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:MemoryKeeper.App.Converters"
    xmlns:dto="using:MemoryKeeper.Application.DTOs"
    mc:Ignorable="d"
    Loaded="PlaceManagementView_OnLoaded"
    Unloaded="PlaceManagementView_OnUnloaded">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="2*,3*" ColumnSpacing="14" RowSpacing="8">
        <!-- Header -->
        <Grid Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <InfoBar
                Grid.Column="0"
                Margin="8,0"
                IsOpen="{Binding IsInfoBarOpen, Mode=TwoWay}"
                Severity="{Binding InfoBarSeverity, Mode=OneWay}"
                Message="{Binding InfoBarMessage, Mode=OneWay}"
                IsClosable="True" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Opacity="0.8"
                FontSize="12"
                Text="{Binding StatusMessage, Mode=OneWay}"
                TextWrapping="NoWrap"
                MaxWidth="280"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <!-- Left panel -->
        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel Spacing="8">
                <!-- Search -->
                <TextBox
                    x:Name="PlaceSearchBox"
                    Header="장소 검색"
                    Text="{Binding PlaceSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="예: 구일로" />
                <Border
                    x:Name="PlaceSuggestionsPanel"
                    Style="{StaticResource MkSuggestionPanelStyle}"
                    Visibility="{Binding HasPlaceSuggestions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="검색 결과" Style="{StaticResource MkSuggestionHeaderStyle}" />
                        <ListView
                            ItemsSource="{Binding PlaceSuggestions, Mode=OneWay}"
                            IsItemClickEnabled="True"
                            ItemClick="PlaceSuggestion_OnItemClick"
                            MaxHeight="160"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Padding="2,4">
                                        <Run Text="{Binding PrimaryText}" FontWeight="SemiBold" />
                                        <Run Text="  " />
                                        <Run Text="{Binding SecondaryText}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Favorites + Recent (compact) -->
                <TextBlock Text="즐겨찾기" FontWeight="SemiBold" FontSize="12" Opacity="0.8" />
                <ItemsControl ItemsSource="{Binding FavoritePlaces, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Margin="0,0,6,4"
                                Padding="8,2"
                                Click="FavoritePlace_OnClick"
                                Tag="{Binding}">
                                <TextBlock>
                                    <Run Text="⭐ " />
                                    <Run Text="{Binding DisplayName}" />
                                </TextBlock>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <StackPanel>
                        <TextBlock Text="최근" FontWeight="SemiBold" FontSize="12" Opacity="0.8" Margin="0,0,0,4" />
                        <ListView
                            ItemsSource="{Binding RecentPlaces, Mode=OneWay}"
                            IsItemClickEnabled="True"
                            ItemClick="RecentPlace_OnItemClick"
                            MaxHeight="96"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" Padding="2,3" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBox
                            Header="목록 검색"
                            Text="{Binding ListSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="이름·주소" />
                        <ListView
                            ItemsSource="{Binding FilteredPlaces, Mode=OneWay}"
                            SelectedItem="{Binding SelectedPlace, Mode=TwoWay}"
                            MaxHeight="120"
                            Margin="0,4,0,0">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Padding="2,3" FontSize="12">
                                        <Run Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                        <Run Text="  " />
                                        <Run Text="{Binding Radius}" />
                                        <Run Text="m" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding UsageCount}" />
                                        <Run Text="회" />
                                    </TextBlock>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Grid>

                <!-- Detail form (compact, visible while dragging) -->
                <TextBlock Text="장소 상세" FontWeight="SemiBold" Margin="0,4,0,0" />
                <StackPanel Spacing="6" MaxWidth="{StaticResource MkInputMaxWidth}" HorizontalAlignment="Left">
                <TextBox
                    Style="{StaticResource MkTextBoxStyle}"
                    Header="장소명"
                    Text="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox
                    Style="{StaticResource MkTextBoxStyle}"
                    Header="주소"
                    Text="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                    <TextBox Header="국가" Text="{Binding Country, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="40" />
                    <TextBox Grid.Column="1" Header="시/도" Text="{Binding Province, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="40" />
                    <TextBox Grid.Column="2" Header="시군구" Text="{Binding City, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="40" />
                </Grid>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                    <ComboBox
                        Header="유형"
                        ItemsSource="{Binding CategoryOptions, Mode=OneWay}"
                        SelectedItem="{Binding Category, Mode=TwoWay}"
                        HorizontalAlignment="Stretch" />
                    <TextBox
                        Grid.Column="1"
                        Header="위도"
                        Text="{Binding LatitudeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox
                        Grid.Column="2"
                        Header="경도"
                        Text="{Binding LongitudeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" RowDefinitions="Auto,Auto">
                    <Slider
                        Grid.ColumnSpan="3"
                        Minimum="50"
                        Maximum="2000"
                        StepFrequency="10"
                        Value="{Binding RadiusMeters, Mode=TwoWay}" />
                    <TextBox
                        Grid.Row="1"
                        Header="반경 (m)"
                        Text="{Binding RadiusText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Width="120"
                        HorizontalAlignment="Left" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,8"
                        FontWeight="SemiBold"
                        Text="{Binding IncludedPhotoCountText, Mode=OneWay}" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="2"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,8"
                        Opacity="0.6"
                        FontSize="11"
                        Text="50~2000m" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <CheckBox Content="활성" IsChecked="{Binding IsActive, Mode=TwoWay}" />
                    <CheckBox Content="즐겨찾기" IsChecked="{Binding IsFavorite, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="새로 작성" Command="{Binding ClearFormCommand}" Padding="10,4" />
                    <Button Content="저장" Style="{StaticResource AccentButtonStyle}" Command="{Binding SaveCommand}" Padding="14,4" />
                    <Button Content="삭제" Command="{Binding DeleteCommand}" Padding="10,4" />
                    <Button Content="새로고침" Command="{Binding LoadCommand}" Padding="10,4" />
                </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Right: map -->
        <Border
            Grid.Row="1"
            Grid.Column="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <WebView2 x:Name="MapWebView" />
        </Border>
    </Grid>
</UserControl>
