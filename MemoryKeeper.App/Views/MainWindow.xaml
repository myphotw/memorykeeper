<Window
    x:Class="MemoryKeeper.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource MkBrushBackground}">
        <NavigationView
            x:Name="RootNavigation"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="False"
            PaneDisplayMode="Top"
            AlwaysShowHeader="False"
            Background="{ThemeResource MkBrushBackground}"
            ItemInvoked="RootNavigation_OnItemInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="홈" Tag="home" IsSelected="True" />
                <NavigationViewItem Content="사진첩" Tag="gallery" />
                <NavigationViewItem Content="방문지도" Tag="visits" />
                <NavigationViewItem Content="여행기록" Tag="travel" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="설정" Tag="settings" />
            </NavigationView.FooterMenuItems>

            <Grid RowDefinitions="Auto,*" Padding="24,12,24,16">
                <TextBlock
                    x:Name="DebugStatusText"
                    Text="{Binding StatusMessage, Mode=OneWay}"
                    Opacity="0.75"
                    Margin="0,0,0,8"
                    TextWrapping="Wrap"
                    MaxLines="2"
                    Visibility="Collapsed" />
                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
